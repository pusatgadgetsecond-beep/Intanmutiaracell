/* Chat Table Dinamis */
function renderPaChat(){
  const data = S.pa.chat || [];
  
  // Deteksi body tabel dan head tabel
  const tb = document.getElementById('pa-chat-tbody') || 
             document.getElementById('tbodyChat') || 
             document.querySelector('#page-pa-chat table tbody');
             
  if (!tb) return; 
  const thead = tb.closest('table')?.querySelector('thead');
  
  // Ambil nilai dari dropdown filter
  const blnEl = document.getElementById('pa-chat-bulan');
  const thnEl = document.getElementById('pa-chat-tahun');
  
  const bln = blnEl ? blnEl.value.trim() : '';
  const thn = thnEl ? thnEl.value.trim() : '';

  // 1. Identifikasi Header Dinamis dari Google Sheet
  let validHeaders = S.pa.chatHeaders || (data.length > 0 ? Object.keys(data[0]) : []);
  let colsMp = [];
  let colTanggal = 'Tanggal';

  validHeaders.forEach(h => {
    let hl = h.toLowerCase().trim();
    if (hl === 'tanggal' || hl === 'date') { colTanggal = h; }
    else if (hl !== '') { colsMp.push(h); }
  });

  // 2. Tulis Header Tabel HTML Secara Otomatis
  if (thead) {
    let theadHTML = `<tr><th>${esc(colTanggal)}</th>`;
    colsMp.forEach(mp => { theadHTML += `<th>${esc(mp)}</th>`; });
    theadHTML += `</tr>`;
    thead.innerHTML = theadHTML;
  }

  // 3. Auto-populate Dropdown Pilihan Tahun (Hanya jika belum terisi)
  if (thnEl && thnEl.options.length <= 1) {
    const years = new Set();
    data.forEach(r => {
      const tglStr = String(r[colTanggal] || r['tanggal'] || '');
      if (tglStr) {
        const dt = parseTgl(tglStr);
        if(dt && !isNaN(dt.getTime())) {
          years.add(dt.getFullYear().toString());
        } else {
          // Cadangan jika parseTgl gagal, ambil 4 angka terakhir (ex: 2024 / 2025)
          const match = tglStr.match(/\b(202\d)\b/);
          if(match) years.add(match[1]);
        }
      }
    });
    const yearArr = Array.from(years).sort((a,b)=>b-a);
    if(yearArr.length === 0) yearArr.push(new Date().getFullYear().toString());
    yearArr.forEach(y => {
      const opt = document.createElement('option');
      opt.value = y; opt.textContent = y;
      thnEl.appendChild(opt);
    });
  }

  // 4. FILTER BULAN & TAHUN (AKURAT UNTUK FORMAT GOOGLE SHEET)
let filtered = data.filter(r => {

  if (!bln && !thn) return true;

  const raw = String(r[colTanggal] || r["Tanggal"] || r["tanggal"] || "").trim();
  if (!raw) return false;

  let hari = "";
  let bulan = "";
  let tahun = "";

  // Hilangkan jam jika ada
  const tgl = raw.split(" ")[0];

  // Pisahkan berdasarkan / atau -
  const p = tgl.split(/[\/\-]/);

  if (p.length === 3) {

    // DD/MM/YYYY
    if (p[2].length === 4) {
      hari = p[0];
      bulan = String(parseInt(p[1],10));
      tahun = p[2];
    }

    // YYYY-MM-DD
    else if (p[0].length === 4) {
      tahun = p[0];
      bulan = String(parseInt(p[1],10));
      hari = p[2];
    }

  }

  const cocokBulan = !bln || bulan === bln;
  const cocokTahun = !thn || tahun === thn;

  return cocokBulan && cocokTahun;

});

  // 5. JIKA SETELAH DIFILTER TERNYATA KOSONG -> TAMPILKAN KETERANGAN KOSONG
  if (!filtered.length) {
    tb.innerHTML = `<tr><td colspan="${colsMp.length + 1}" style="text-align:center; padding:40px; color:var(--t3);">
      <div style="font-size:36px; margin-bottom:12px;">📭</div>
      <p style="font-weight:500; font-size:14px; margin:0;">Tidak ada data performa respon chat di periode ini</p>
    </td></tr>`;
    
    const lastEl = document.getElementById('pa-chat-last-update');
    if(lastEl) lastEl.textContent = '-';
    return;
  }

  // 6. UPDATE TANGGAL TERAKHIR (LAST UPDATE) DARI DATA YANG TAMPIL
  const last = filtered[filtered.length - 1];
  const lastEl = document.getElementById('pa-chat-last-update');
  if (lastEl && last) {
    lastEl.textContent = esc(formatTanggalTampilan(last[colTanggal] || last['tanggal'] || '-'));
  }

  // 7. FORMATTER WARNA PERSENTASE CHAT
const formatCell = (val) => {
  // 1. Cek jika data kosong (Abu-abu)
  if (val === '-' || val === '' || val === null || val === undefined) {
    return `<td class="num" style="color: #9CA3AF; text-align: center;">-</td>`;
  }
 
  // 2. Bersihkan teks dan ubah menjadi angka
  const numString = String(val).replace(/,/g, '.').replace(/%/g, '').trim();
  const num = parseFloat(numString);
 
  let colorStyle = '';
 
  // 3. Logika Pewarnaan
  if (!isNaN(num)) {
    if (num >= 98) {
      colorStyle = 'color: #10B981; font-weight: 600;'; // 🟢 Hijau
    }
    else if (num >= 90) {
      colorStyle = 'color: #F59E0B; font-weight: 600;'; // 🟡 Kuning
    }
    else {
      // Nilai < 90 (Termasuk 89.00% ke bawah) akan masuk ke sini
      colorStyle = 'color: #EF4444; font-weight: 600;'; // 🔴 Merah
    }
  } else {
    // Jika data tidak valid, kembalikan abu-abu
    colorStyle = 'color: #9CA3AF;'; // ⚪ Abu-abu
  }
 
  return `<td class="num" style="${colorStyle} text-align: center;">${val}</td>`;
};

  // 8. RENDER SELURUH BARIS DATA YANG LOLOS FILTER KEDALAM TABEL
  tb.innerHTML = filtered.map(r => {
    const rawTgl = r[colTanggal] || r['tanggal'] || '-';
    let trHTML = `<tr><td style="font-weight:600; color:var(--t1); text-align:left;">${esc(formatTanggalTampilan(rawTgl))}</td>`;
    colsMp.forEach(mp => {
      trHTML += formatCell(r[mp]);
    });
    trHTML += `</tr>`;
    return trHTML;
  }).join('');
}

