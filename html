function formatTanggalTampilan(str) {
  if (!str || str === '-' || str === '') return '—';
  
  // Gunakan fungsi parseTgl yang sudah ada untuk membaca berbagai format (String, Date, ISO, Indo)
  const dt = parseTgl(str);
  
  // Jika gagal parsing, kembalikan string aslinya sebagai fallback
  if (!dt || isNaN(dt.getTime())) return String(str);

  // Format menjadi dd/MM/yyyy HH:mm:ss
  const pad = n => String(n).padStart(2, '0');
  const d = pad(dt.getDate());
  const m = pad(dt.getMonth() + 1);
  const y = dt.getFullYear();
  const H = pad(dt.getHours());
  const M = pad(dt.getMinutes());
  const S = pad(dt.getSeconds());

  return `${d}/${m}/${y} ${H}:${M}:${S}`;
}

