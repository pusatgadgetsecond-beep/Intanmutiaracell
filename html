// --- HELPER 1: KONVERSI JAM/WAKTU KE DETIK ---
function parseWaktuKeDetik(val) {
  if (!val || val === '-' || val.toString().toLowerCase() === 'libur') return 0;
  let str = val.toString().trim().toLowerCase().replace('jam', '').trim();
  
  if (!str.includes(':') && !isNaN(parseFloat(str))) {
    return Math.round(parseFloat(str) * 24 * 3600);
  }
  
  if (str.includes(':')) {
    let parts = str.split(':').map(Number);
    if (parts.length === 3) return (parts[0] * 3600) + (parts[1] * 60) + (parts[2] || 0);
    if (parts.length === 2) return (parts[0] * 3600) + (parts[1] * 60);
  }
  
  let num = parseFloat(str);
  return isNaN(num) ? 0 : Math.round(num * 3600);
}

// --- HELPER 2: KONVERSI DETIK KE FORMAT TEKS JAM ---
function detikKeFormatJam(detik) {
  if (!detik || detik <= 0) return "0 Jam";
  let jam = Math.floor(detik / 3600);
  let sisaMenit = Math.floor((detik % 3600) / 60);
  return sisaMenit > 0 ? `${jam} Jam ${sisaMenit}m` : `${jam} Jam`;
}

// --- HELPER 3: DETEKSI TANGGAL SUPER UNIVERSAL (FIX MEI & FORMAT STRIP) ---
function parseTglAkurat(dateStr) {
  if (!dateStr) return new Date(0);
  if (dateStr instanceof Date) return dateStr;

  let str = dateStr.toString().trim();
  let firstPart = str.split(' ')[0]; // Ambil bagian tanggalnya saja

  // 1. Deteksi Format DD/MM/YYYY atau DD-MM-YYYY (Contoh: 15/05/2024 atau 15-05-2024)
  let match = firstPart.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})$/);
  if (match) {
    return new Date(match[3], match[2] - 1, match[1]); // YYYY, MM, DD
  }

  // 2. Deteksi Format YYYY/MM/DD atau YYYY-MM-DD
  match = firstPart.match(/^(\d{4})[\/\-](\d{1,2})[\/\-](\d{1,2})$/);
  if (match) {
    return new Date(match[1], match[2] - 1, match[3]); 
  }

  // 3. Fallback: Terjemahkan Bulan Indonesia ke Inggris
  let safeStr = str.toLowerCase()
    .replace(/\b(januari|jan)\b/g, 'January')
    .replace(/\b(februari|feb)\b/g, 'February')
    .replace(/\b(maret|mar)\b/g, 'March')
    .replace(/\b(agustus|agu|agt)\b/g, 'August')
    .replace(/\b(mei)\b/g, 'May')
    .replace(/\b(oktober|okt)\b/g, 'October')
    .replace(/\b(november|nov)\b/g, 'November')
    .replace(/\b(desember|des)\b/g, 'December');

  let dt = new Date(safeStr);
  return isNaN(dt.getTime()) ? new Date(0) : dt;
}

