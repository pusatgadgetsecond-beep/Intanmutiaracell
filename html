// 3. RENDER TABEL LIVE (FILTER BULAN & TAHUN) - UPDATE FORMAT HORIZONTAL
// =========================================================================
function renderPaTabelLive(bulan, tahun) {
  const rawSettings = S.setting || S.pa.setting || [];
  const liveMaster = [];
  let currentKategori = "";

  // A. Ambil data Host & Target dari Sheet Setting
  rawSettings.forEach(r => {
    let kat = (r['Kategori'] || '').toString().trim();
    if (kat) currentKategori = kat;

    // Memastikan Kategori adalah "Jam Tayang Live"
    if (currentKategori.toLowerCase().includes('jam tayang live') || currentKategori.toLowerCase().includes('target jam')) {
      let host = (r['Host'] || '').toString().trim();
      let targetVal = (r['Jam'] || r['Target Live'] || '0').toString().trim(); 
      
      if (host) {
        liveMaster.push({ 
          host: host, 
          targetSecs: timeToSeconds(targetVal)
        });
      }
    }
  });

  // B. Ambil & Filter Data dari Sheet 'Host Live / Performa Live'
  const sourceData = (S.pa.live || []).filter(r => paIsDateMatch(r, bulan, tahun));

  let html = "";
  let totalTargetSecs = 0;
  let totalTerjualSecs = 0;

  // C. Kalkulasi per Host (LOGIKA BARU UNTUK FORMAT HEADER MENYAMPING)
  liveMaster.forEach(m => {
    let terjualSecs = 0;
    const hostKey = m.host.toLowerCase().trim(); // contoh: 'sofi', 'aini'

    sourceData.forEach(r => {
      let durasi = '0';
      
      // Looping ke semua header/kolom di baris tersebut
      for (let key in r) {
        const header = key.toLowerCase().trim();
        
        // Lewati kolom standar yang bukan nama host
        if (header === 'tanggal' || header === 'no' || header === 'status') continue;
        
        // Cek kecocokan nama (misal: header "sofia" akan membaca "sofi")
        if (header.includes(hostKey) || hostKey.includes(header)) {
           durasi = r[key];
           break;
        }
      }

      // Pastikan durasi ada isinya, dan bukan "-" atau "Libur" sebelum dihitung
      if (durasi && durasi !== '-' && durasi.toLowerCase() !== 'libur') {
        let sec = timeToSeconds(durasi);
        terjualSecs += isNaN(sec) ? 0 : sec;
      }
    });

    totalTargetSecs += m.targetSecs;
    totalTerjualSecs += terjualSecs;

    // Render baris untuk host tersebut
    html += generateLiveTableRowHTML(m.host, m.targetSecs, terjualSecs, false, bulan, tahun);
  });

  // D. Render Baris Total
  if (liveMaster.length > 0) {
    html += generateLiveTableRowHTML("Total", totalTargetSecs, totalTerjualSecs, true, bulan, tahun);
  }

  // E. Masukkan ke dalam HTML
  const el = $('pa-dash-tbl-live'); 
  if (el) {
    el.innerHTML = html || '<tr><td colspan="6" style="text-align:center; padding: 20px; color: #6c757d;">Tidak ada data Target Jam Live. Pastikan Kategori "Jam Tayang Live" di setting sudah terisi.</td></tr>';
  }
}

