function timeToSec(s){
  if(!s||s==='-') return 0;
  const p = String(s).split(':');
  if(p.length===3) return +p[0]*3600 + +p[1]*60 + +p[2];
  return 0;
}
function secToTime(s){
  const h=Math.floor(s/3600), m=Math.floor((s%3600)/60), sc=s%60;
  return `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(sc).padStart(2,'0')}`;
}
 
function parseTgl(str) {
  if (!str) return null;
  // Jika formatnya sudah berupa objek Date, langsung pakai
  if (str instanceof Date) return str;

  let s = String(str).trim();
  
  // Handle format DD/MM/YYYY
  if (s.includes('/')) {
    const p = s.split('/');
    // p[0]=Tanggal, p[1]=Bulan, p[2]=Tahun
    return new Date(p[2], p[1] - 1, p[0]);
  }
  
  // === FIX UNTUK BULAN INDONESIA ("01, Mei, 2026") ===
  const bulanIndo = {
    'januari':'01', 'jan':'01',
    'februari':'02', 'feb':'02',
    'maret':'03', 'mar':'03',
    'april':'04', 'apr':'04',
    'mei':'05',
    'juni':'06', 'jun':'06',
    'juli':'07', 'jul':'07',
    'agustus':'08', 'agu':'08',
    'september':'09', 'sep':'09',
    'oktober':'10', 'okt':'10',
    'november':'11', 'nov':'11',
    'desember':'12', 'des':'12'
  };

  let lowerS = s.toLowerCase();
  for (const [namaBulan, angkaBulan] of Object.entries(bulanIndo)) {
    if (lowerS.includes(namaBulan)) {
      // Hilangkan koma, lalu pecah berdasarkan spasi ("01, mei, 2026" -> ["01", "mei", "2026"])
      let parts = lowerS.replace(/,/g, '').split(/\s+/);
      if (parts.length >= 3) {
        let d = parts[0].padStart(2, '0');
        let m = angkaBulan;
        let y = parts[2];
        // Ubah menjadi format standar ISO (YYYY-MM-DD) agar pasti berhasil
        return new Date(`${y}-${m}-${d}T00:00:00`);
      }
    }
  }

  // Jika formatnya sudah standar Inggris/ISO
  return new Date(s);
}
 
