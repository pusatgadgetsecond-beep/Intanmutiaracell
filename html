/* ═══════════════════════════════════════════════════════════
   [GABUNGAN UTUH] PERBAIKAN UI/UX POPUP & PAGINATION
   Sesuai Tema Super Dashboard — Full CSS Optimization
═══════════════════════════════════════════════════════════ */

/* 1. LAYOUT UTAMA MODAL (Tengah, Proporsional, Tidak Penuh Layar) */
.mp-modal-overlay {
  position: fixed; inset: 0; z-index: 100000;
  background: rgba(15, 23, 42, 0.5); backdrop-filter: blur(4px);
  display: flex; align-items: center; justify-content: center;
  padding: 20px; opacity: 0; pointer-events: none; transition: var(--tx);
}
.mp-modal-overlay.active { opacity: 1; pointer-events: auto; }

.mp-modal-container {
  width: 100%; max-width: 850px; /* Ukuran sedang & ideal */
  height: 85vh; /* Batas tinggi agar tidak menabrak layar atas/bawah */
  background: var(--bg2);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-modal);
  display: flex; flex-direction: column; /* Mengunci Header, Filter, & Footer */
  overflow: hidden; transform: scale(0.98); transition: var(--tx);
  border: 1px solid var(--border);
}
.mp-modal-overlay.active .mp-modal-container { transform: scale(1); }

/* 2. HEADER & TABS (Sejajar, Modern, Indikator Jelas) */
.mp-modal-header {
  padding: 16px 24px;
  background: var(--bg2); border-bottom: 1px solid var(--border);
  display: flex; justify-content: space-between; align-items: center;
  flex-shrink: 0;
}
.mp-modal-title-area {
  display: flex; align-items: center; gap: 32px; flex-wrap: wrap;
}
.mp-modal-title { margin: 0; font-size: 16px; font-weight: 700; color: var(--t1); }
.mp-modal-tabs { display: flex; gap: 16px; }
.mp-tab-btn {
  background: none; border: none; padding: 8px 0; font-size: 13.5px;
  font-weight: 600; color: var(--t3); cursor: pointer; border-bottom: 2px solid transparent;
  transition: var(--tx); margin-bottom: -17px; /* Garis indikator menyatu dengan border bawah header */
}
.mp-tab-btn:hover { color: var(--c); }
.mp-tab-btn.active { color: var(--c); border-bottom-color: var(--c); }
.mp-modal-close {
  width: 32px; height: 32px; border: none; background: var(--bg); border-radius: 8px;
  color: var(--t3); font-size: 18px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: var(--tx);
}
.mp-modal-close:hover { background: #FEF2F2; color: var(--r); }

/* 3. AREA KONTEN (Mengunci Scroll Hanya Pada Tabel) */
.mp-modal-body {
  display: flex; flex-direction: column; flex: 1;
  overflow: hidden; background: var(--bg);
}
.mp-tab-content { display: none; flex-direction: column; flex: 1; overflow: hidden; }
.mp-tab-content.active { display: flex; }

/* 4. AREA FILTER (Tinggi Seragam 38px, Rapih Berjejer) */
.mp-filter-wrapper {
  padding: 16px 24px; background: var(--bg2); border-bottom: 1px solid var(--border);
  display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px;
  flex-shrink: 0;
}
.mp-filter-left { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; flex: 1; }
.mp-search-group { display: flex; align-items: center; gap: 0; }
.mp-search-group .mp-select-search { border-radius: 6px 0 0 6px; border-right: none; }
.mp-search-group .mp-input { border-radius: 0 6px 6px 0; min-width: 220px; }

/* Standardisasi Elemen Form Filter */
.mp-select, .mp-select-search, .mp-input, .mp-btn-cari, .mp-btn-reset {
  height: 38px; padding: 0 12px; font-size: 13px; font-family: var(--font);
  border: 1px solid var(--border); border-radius: 6px; outline: none; transition: var(--tx);
  background: var(--bg2); color: var(--t2); box-sizing: border-box;
}
.mp-input:focus, .mp-select:focus { border-color: var(--c); box-shadow: 0 0 0 3px var(--c3); }
.mp-btn-cari { background: var(--c); color: #fff; border-color: var(--c); font-weight: 600; cursor: pointer; }
.mp-btn-cari:hover { background: var(--c2); border-color: var(--c2); }
.mp-btn-reset { cursor: pointer; font-weight: 500; }
.mp-btn-reset:hover { background: var(--bg); color: var(--t1); }

.mp-filter-right { display: flex; align-items: center; }
.mp-checkbox-label { display: flex; align-items: center; gap: 8px; font-size: 12.5px; font-weight: 500; color: var(--t2); cursor: pointer; }

/* 5. TABEL PRODUK (Lebar Kolom Permanen & Sticky Header) */
.mp-table-container {
  flex: 1; overflow-y: auto; background: var(--bg2); padding: 0; /* Hanya area ini yang boleh di-scroll */
}
.mp-table { width: 100%; border-collapse: separate; border-spacing: 0; text-align: left; table-layout: fixed; }

/* Pembagian Lebar Kolom Agar Stabil */
.mp-table th:nth-child(1) { width: 50px; text-align: center; } /* Checkbox */
.mp-table th:nth-child(2) { width: auto; }                      /* Info Produk */
.mp-table th:nth-child(3) { width: 160px; }                     /* Harga */
.mp-table th:nth-child(4) { width: 130px; text-align: center; } /* Stok */

.mp-table th {
  position: sticky; top: 0; z-index: 10; background: #F8FAFC;
  padding: 12px 16px; font-size: 11px; font-weight: 700; color: var(--t3);
  text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid var(--border);
}
.mp-table td {
  padding: 14px 16px; border-bottom: 1px solid var(--border); vertical-align: middle;
  font-size: 13px; color: var(--t2);
}
.mp-table tr:hover:not(.disabled-row) { background: rgba(30, 136, 229, 0.03); }

/* Susunan Informasi Produk Bertingkat */
.mp-p-name { font-weight: 600; color: var(--t1); font-size: 13px; margin-bottom: 4px; line-height: 1.4; white-space: normal; }
.mp-p-id { font-size: 11px; color: var(--t3); font-family: var(--mono); }
.mp-table td:nth-child(1) { text-align: center; }
.mp-table td:nth-child(4) { text-align: center; }

/* Badge Status Stok */
.mp-p-stok { display: inline-flex; justify-content: center; width: 80px; padding: 4px 0; border-radius: 20px; font-size: 11px; font-weight: 600; }
.mp-p-stok.ready { background: var(--g2); color: var(--g); }
.mp-p-stok.empty { background: rgba(239, 68, 68, 0.1); color: var(--r); }

/* 6. PERBAIKAN TOTAL PAGINATION (Sesuai Struktur Tema Anda) */
.mp-pagination {
  padding: 12px 24px; background: var(--bg2); border-top: 1px solid var(--border);
  display: flex; justify-content: space-between; align-items: center; flex-shrink: 0;
}
.mp-pag-info { font-size: 12.5px; color: var(--t3); font-weight: 500; }
.mp-pag-controls { display: flex; align-items: center; gap: 8px; }
.mp-pag-numbers { display: flex; align-items: center; gap: 4px; } /* Jarak rapat antar angka */

/* Desain Tombol Angka & Navigasi */
.mp-pag-num, 
.mp-pag-controls .pag-btn {
  min-width: 34px; height: 34px; padding: 0 6px; border: 1px solid var(--border); 
  background: var(--bg2); border-radius: 6px; font-size: 13px; font-weight: 500; 
  color: var(--t2); font-family: var(--font); cursor: pointer;
  display: flex; align-items: center; justify-content: center; transition: var(--tx); box-sizing: border-box;
}
/* Hover Angka & Navigasi */
.mp-pag-num:hover:not(.active):not(:disabled), 
.mp-pag-controls .pag-btn:hover:not(:disabled) { 
  background: var(--bg); color: var(--t1); border-color: var(--c2); 
}
/* Tombol Angka Halaman Aktif (Biru Khas Tema Anda) */
.mp-pag-num.active { 
  background: var(--c); color: #fff; border-color: var(--c); 
  font-weight: 600; box-shadow: 0 2px 4px var(--c3); cursor: default; 
}
.mp-pag-controls .pag-btn:disabled { opacity: 0.5; cursor: not-allowed; background: var(--bg); }

/* 7. FOOTER POPUP (Tombol Aksi & Status Pilihan) */
.mp-modal-footer {
  padding: 16px 24px; background: var(--bg3); border-top: 1px solid var(--border);
  display: flex; justify-content: space-between; align-items: center; flex-shrink: 0;
}
.mp-footer-left span { font-size: 13px; font-weight: 500; color: var(--t3); }
.mp-footer-left b { color: var(--c); font-size: 14px; margin: 0 2px; }
.mp-footer-right { display: flex; gap: 12px; }

.mp-btn-batal {
  padding: 9px 20px; border: 1px solid var(--border); border-radius: 6px;
  background: var(--bg2); color: var(--t2); font-weight: 600; font-size: 13px; cursor: pointer; transition: var(--tx);
}
.mp-btn-batal:hover { background: var(--bg); color: var(--t1); border-color: var(--border2); }

.mp-btn-konfirmasi {
  padding: 9px 24px; border: none; border-radius: 6px;
  background: var(--c); color: #fff; font-weight: 600; font-size: 13px; cursor: pointer; box-shadow: 0 2px 4px var(--c3); transition: var(--tx);
}
.mp-btn-konfirmasi:hover { background: var(--c2); transform: translateY(-1px); box-shadow: 0 4px 6px var(--c4); }

/* 8. RESPONSIVE MOBILE SINKRONISASI */
@media (max-width: 768px) {
  .mp-modal-container { height: 100vh; max-height: 100vh; border-radius: 0; max-width: 100%; border: none; }
  .mp-modal-title-area { gap: 16px; flex-direction: column; align-items: flex-start; }
  .mp-modal-tabs { width: 100%; overflow-x: auto; padding-bottom: 2px; }
  .mp-filter-wrapper { flex-direction: column; align-items: stretch; }
  .mp-filter-left { flex-direction: column; align-items: stretch; }
  .mp-search-group { width: 100%; }
  .mp-search-group .mp-input { flex: 1; min-width: 0; }
  .mp-table th:nth-child(3) { width: 110px; }
  .mp-pagination { flex-direction: column; gap: 12px; align-items: center; }
  .mp-modal-footer { flex-direction: column; gap: 16px; }
  .mp-footer-right { width: 100%; display: flex; }
  .mp-btn-batal, .mp-btn-konfirmasi { flex: 1; text-align: center; justify-content: center; }
