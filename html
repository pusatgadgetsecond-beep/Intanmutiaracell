function renderPaChat() {
  const data = S.pa.chat || [];
  const tb = document.getElementById('pa-chat-tbody') || document.getElementById('tbodyChat') || document.querySelector('#page-pa-chat table tbody');
  if (!tb) return; 
  const thead = tb.closest('table')?.querySelector('thead');
  
  const bln = S.pa.chatBulan;
  const thn = S.pa.chatTahun;

  let validHeaders = S.pa.chatHeaders || (data.length > 0 ? Object.keys(data[0]) : []);
  let colsMp = [];
  let colTanggal = 'Tanggal';

  validHeaders.forEach(h => {
    let hl = h.toLowerCase().trim();
    if (hl === 'tanggal' || hl === 'date') { colTanggal = h; }
    else if (hl !== '') { colsMp.push(h); }
  });

  if (thead) {
    let theadHTML = `<tr><th>${esc(colTanggal)}</th>`;
    colsMp.forEach(mp => { theadHTML += `<th>${esc(mp)}</th>`; });
    theadHTML += `</tr>`;
    thead.innerHTML = theadHTML;
  }

  const thnEl = document.getElementById('pa-chat-tahun');
  if (thnEl && thnEl.options.length <= 1) {
    const years = new Set();
    data.forEach(r => {
      const tglStr = String(r[colTanggal] || r['tanggal'] || '');
      if (tglStr) {
        const dt = parseTgl(tglStr);
        if(dt && !isNaN(dt.getTime())) { years.add(dt.getFullYear().toString()); } 
        else { const match = tglStr.match(/\b(202\d)\b/); if(match) years.add(match[1]); }
      }
    });
    const yearArr = Array.from(years).sort((a,b) => b - a);
    if(yearArr.length === 0) yearArr.push(new Date().getFullYear().toString());
    yearArr.forEach(y => { thnEl.appendChild(new Option(y, y)); });
  }

  // Filter Mandiri
  let filtered = data.filter(r => paIsDateMatch(r, bln, thn));

  if (!filtered.length) {
    tb.innerHTML = `<tr><td colspan="${colsMp.length + 1}" style="text-align:center; padding:40px; color:var(--t3);"><div style="font-size:36px; margin-bottom:12px;">📭</div><p style="font-weight:500; font-size:14px; margin:0;">Tidak ada data performa respon chat di periode ini</p></td></tr>`;
    const lastEl = document.getElementById('pa-chat-last-update');
    if(lastEl) lastEl.textContent = '-';
    return;
  }

  const last = filtered[filtered.length - 1];
  const lastEl = document.getElementById('pa-chat-last-update');
  if (lastEl && last) {
    lastEl.textContent = esc(formatTanggalTampilan(last[colTanggal] || last['tanggal'] || '-'));
  }

  const formatCell = (val) => {
    if (val === '-' || val === '' || val === null || val === undefined) return `<td class="num" style="color: #9CA3AF; text-align: center;">-</td>`;
    const numString = String(val).replace(/,/g, '.').replace(/%/g, '').trim();
    const num = parseFloat(numString);
    let colorStyle = 'color: #9CA3AF;';
    if (!isNaN(num)) {
      if (num >= 98) colorStyle = 'color: #10B981; font-weight: 600;';
      else if (num >= 90) colorStyle = 'color: #F59E0B; font-weight: 600;';
      else colorStyle = 'color: #EF4444; font-weight: 600;';
    }
    return `<td class="num" style="${colorStyle} text-align: center;">${val}</td>`;
  };

  tb.innerHTML = filtered.map(r => {
    const rawTgl = r[colTanggal] || r['tanggal'] || '-';
    let trHTML = `<tr><td style="font-weight:600; color:var(--t1); text-align:left;">${esc(formatTanggalTampilan(rawTgl))}</td>`;
    colsMp.forEach(mp => { trHTML += formatCell(r[mp]); });
    trHTML += `</tr>`;
    return trHTML;
  }).join('');
}
 
