// Helper Format Data
function paNorm(r, jenis) {
  return {
    jenis, toko: r['Toko'] || r['toko'] || '',
    target: r['Target'] || r['target'] || '-', terjual: parseInt(r['Terjual'] || r['terjual'] || 0),
    status: r['Status'] || r['status'] || '',
    bulan: r['Bulan'] || r['bulan'] || '',
    ...r
  };
}

// Helper: Pencocokan Tanggal Tanpa Merusak Data Master
function paIsDateMatch(row, targetBulan, targetTahun) {
  if (!targetBulan && !targetTahun) return true;
  let rawTgl = row['Tanggal'] || row['tanggal'] || row['Date'] || row['date'];
  if (!rawTgl) return false;
  
  let dt = parseTgl(rawTgl);
  if (!dt || isNaN(dt.getTime())) return false;
  
  let matchB = !targetBulan || (dt.getMonth() + 1).toString() === targetBulan.toString();
  let matchY = !targetTahun || dt.getFullYear().toString() === targetTahun.toString();
  return matchB && matchY;
}

// Helper: Hitung Total Dinamis
function hitungTotalDashboard(tipeData, targetBulan, targetTahun) {
  let data = S.pa[tipeData] || [];
  let grandTotal = 0;
  
  let colTanggal = 'Tanggal';
  if (data.length > 0) {
    const headers = Object.keys(data[0]);
    headers.forEach(h => {
      let hl = h.toLowerCase().trim();
      if (hl === 'tanggal' || hl === 'date') colTanggal = h;
    });
  }

  data.forEach(row => {
    let rawTgl = row[colTanggal] || row['tanggal'] || row['Tanggal'];
    if (!rawTgl) return;
    
    if (paIsDateMatch({ 'Tanggal': rawTgl }, targetBulan, targetTahun)) {
      Object.keys(row).forEach(key => {
        let kl = key.toLowerCase().trim();
        if (kl !== 'tanggal' && kl !== 'date' && kl !== 'total' && kl !== 'keterangan' && kl !== '') {
           let val = parseInt(String(row[key]).replace(/[^\d]/g, '')) || 0;
           grandTotal += val;
        }
      });
    }
  });

  return grandTotal;
}

