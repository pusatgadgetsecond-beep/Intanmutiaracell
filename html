<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Mutiara Group — Super Dashboard</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
<style>
/* ═══════════════════════════════════════════════════════════
   DESIGN TOKENS — SaaS Premium Enterprise (Unified & Cleaned)
═══════════════════════════════════════════════════════════ */
:root {
  --c: #1E88E5;            /* Primary Blue */
  --c2: #60A5FA;           /* Secondary Blue */
  --c3: rgba(30, 136, 229, 0.1); 
  --c4: rgba(30, 136, 229, 0.25);
  
  --p: #8B5CF6;            /* Purple accent */
  --g: #22C55E;            /* Success Green */
  --g2: rgba(34, 197, 94, 0.1);
  --y: #F59E0B;            /* Warning Yellow */
  --r: #EF4444;            /* Danger Red */
  
  /* Background & Layout */
  --bg: #F0F4F8;           /* Light bluish grey */
  --bg2: #FFFFFF;          /* Pure white for cards */
  --bg3: #F8FAFC;          /* Sub-backgrounds/Hover */
  
  --glass: rgba(255, 255, 255, 0.9);
  --border: #E2E8F0;
  --border2: #CBD5E1;
  
  /* Text Colors */
  --t1: #0F172A;           /* Slate 900 - Heading */
  --t2: #334155;           /* Slate 700 - Body */
  --t3: #64748B;           /* Slate 500 - Muted */
  --t4: #94A3B8;           /* Slate 400 - Disabled */
  
  --font: 'Inter', sans-serif;
  --mono: 'Inter', monospace;
  
  --sb: 260px;
  --sb-c: 76px;
  --r-lg: 16px;            /* Unified Card Radius */
  --r: 8px;                /* Unified Button/Input Radius */
  
  --sh: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
  --sh-hover: 0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -2px rgba(0, 0, 0, 0.04);
  --sh-modal: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  --tx: all .2s ease-in-out;
}

/* Mematikan mode gelap bawaan agar tema selalu Clean SaaS */
body.light, body {
  background: var(--bg); color: var(--t2); font-family: var(--font);
  min-height: 100vh; overflow-x: hidden; margin: 0; padding: 0;
}
*,*::before,*::after { box-sizing: border-box; }
a { text-decoration: none; color: var(--c); transition: var(--tx); }
a:hover { color: var(--c2); }

/* Hilangkan background orbs jadul, gunakan clean background */
.bg-scene, .bg-grad, .bg-orb, .bg-mesh { display: none; }

/* ═══════════════════════════════════════════════════════════
   LOADING OVERLAY
═══════════════════════════════════════════════════════════ */
.load-ov { position: fixed; inset: 0; z-index: 999999; background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(8px); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; transition: opacity .3s; }
.load-ov.hide { opacity: 0; pointer-events: none; }
.loader { width: 44px; height: 44px; border-radius: 50%; border: 4px solid var(--border); border-top-color: var(--c); animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg) } }

/* ═══════════════════════════════════════════════════════════
   LOGIN PAGE
═══════════════════════════════════════════════════════════ */
#login-screen { position: fixed; inset: 0; z-index: 99999; display: flex; align-items: center; justify-content: center; padding: 20px; background: var(--bg); }
.login-card { width: 100%; max-width: 400px; background: var(--bg2); border: 1px solid var(--border); border-radius: var(--r-lg); padding: 40px; box-shadow: var(--sh-modal); }
.login-logo { width: 56px; height: 56px; background: linear-gradient(135deg, var(--c), var(--c2)); border-radius: 14px; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; box-shadow: 0 4px 12px var(--c4); }
.login-title { font-size: 20px; font-weight: 700; color: var(--t1); text-align: center; margin-bottom: 6px; }
.login-sub { font-size: 13px; color: var(--t3); text-align: center; margin-bottom: 28px; line-height: 1.5; }
.lin-wrap { position: relative; margin-bottom: 16px; }
.login-label { display: block; font-size: 12px; font-weight: 600; color: var(--t2); margin-bottom: 6px; }
.login-input { width: 100%; height: 44px; background: var(--bg); border: 1px solid var(--border); border-radius: var(--r); padding: 0 16px; font-size: 14px; color: var(--t1); outline: none; transition: var(--tx); }
.login-input:focus { background: var(--bg2); border-color: var(--c); box-shadow: 0 0 0 3px var(--c3); }
.btn-login { width: 100%; height: 46px; margin-top: 10px; background: var(--c); color: #fff; border: none; border-radius: var(--r); font-size: 15px; font-weight: 600; cursor: pointer; transition: var(--tx); }
.btn-login:hover { background: var(--c2); transform: translateY(-1px); box-shadow: 0 4px 12px var(--c4); }

/* ═══════════════════════════════════════════════════════════
   SIDEBAR & TOPBAR
═══════════════════════════════════════════════════════════ */
.sidebar { width: var(--sb); height: 100vh; position: fixed; top: 0; left: 0; z-index: 1000; background: var(--bg2); border-right: 1px solid var(--border); display: flex; flex-direction: column; transition: var(--tx); overflow-y: auto; }
.sidebar::-webkit-scrollbar { width: 4px; }
.sidebar::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 4px; }

.sb-logo { padding: 20px 24px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 12px; }
.sb-logo-icon { width: 36px; height: 36px; border-radius: 10px; background: var(--c); display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; color: #fff; }
.sb-logo-text { font-size: 15px; font-weight: 700; color: var(--t1); line-height: 1.2; }
.sb-logo-text small { display: block; font-size: 11px; font-weight: 500; color: var(--t3); }

.sb-nav { flex: 1; padding: 16px; }
.sb-sec { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--t4); padding: 12px; margin-top: 8px; }
.sb-item { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-radius: var(--r); cursor: pointer; color: var(--t2); font-size: 13.5px; font-weight: 500; margin-bottom: 4px; transition: var(--tx); white-space: nowrap; }
.sb-item:hover { background: var(--bg); color: var(--c); }
.sb-item.active { background: var(--c3); color: var(--c); font-weight: 600; }
.sb-item .sb-ic { width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; font-size: 16px; color: inherit; }

.sidebar.closed { width: var(--sb-c); }
.sidebar.closed .sb-logo-text, .sidebar.closed .sb-item span, .sidebar.closed .sb-sec { display: none; }
.sidebar.closed .sb-logo { padding: 20px 0; justify-content: center; }
.sidebar.closed .sb-item { justify-content: center; padding: 12px 0; }
.sidebar.closed .sb-item .sb-ic { margin: 0; }

.toggle-sb { position: absolute; top: 26px; right: -14px; width: 28px; height: 28px; border-radius: 50%; border: 1px solid var(--border); background: #fff; color: var(--t3); display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 12px; z-index: 1001; box-shadow: var(--sh); }
.toggle-sb:hover { color: var(--c); border-color: var(--c); }

.main { margin-left: var(--sb); flex: 1; display: flex; flex-direction: column; transition: var(--tx); min-width: 0; }
.sidebar.closed ~ .main { margin-left: var(--sb-c); }

.topbar { position: sticky; top: 0; z-index: 900; height: 68px; padding: 0 32px; background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px); border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; gap: 16px; }
.tb-title { font-size: 18px; font-weight: 600; color: var(--t1); }
.tb-title small { display: block; font-size: 12px; color: var(--t3); font-weight: 400; margin-top: 2px; }

.tb-r { display: flex; align-items: center; gap: 12px; margin-left: auto; }
.tb-live { display: flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; background: var(--g2); color: var(--g); border: 1px solid rgba(34, 197, 94, 0.2); }
.live-dot { width: 6px; height: 6px; background: var(--g); border-radius: 50%; animation: ldot 1.5s infinite; }
@keyframes ldot { 0%,100%{opacity:1} 50%{opacity:0.4} }
.tb-btn { width: 36px; height: 36px; border-radius: var(--r); border: 1px solid var(--border); background: var(--bg2); display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--t2); font-size: 16px; transition: var(--tx); }
.tb-btn:hover { background: var(--bg); color: var(--c); border-color: var(--border2); }
.tb-mod-switch { display: flex; gap: 4px; background: var(--bg); padding: 4px; border-radius: var(--r); border: 1px solid var(--border); }
.tb-mod-btn { padding: 6px 12px; border-radius: 6px; font-size: 12px; font-weight: 500; cursor: pointer; color: var(--t2); transition: var(--tx); }
.tb-mod-btn.on { background: var(--bg2); color: var(--c); box-shadow: var(--sh); font-weight: 600; }
#themeBtn { display: none; }

/* Hamburger Menu & Overlay Background (Hidden di Desktop) */
.tb-ham { display: none; width: 36px; height: 36px; border-radius: var(--r); border: 1px solid var(--border); background: var(--bg2); align-items: center; justify-content: center; cursor: pointer; color: var(--t2); font-size: 18px; flex-shrink: 0; }
.sb-ov { display: none; position: fixed; inset: 0; width: 100vw; height: 100vh; z-index: 999; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); opacity: 0; transition: opacity 0.3s ease; }
.sb-ov.show { display: block; opacity: 1; pointer-events: all; }

/* ═══════════════════════════════════════════════════════════
   GLOBAL CARDS & CONTAINERS
═══════════════════════════════════════════════════════════ */
.page-wrap { padding: 32px; flex: 1; max-width: 1600px; margin: 0 auto; width: 100%; }
.page { display: none; animation: fadeIn .3s ease; }
.page.active { display: block; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

.card { background: var(--bg2); border: 1px solid var(--border); border-radius: var(--r-lg); box-shadow: var(--sh); margin-bottom: 20px; transition: var(--tx); overflow: hidden; }
.card:hover { box-shadow: var(--sh-hover); border-color: var(--border2); }
.cp { padding: 24px; }
.cp-sm { padding: 16px 24px; }

.sec-hd { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; flex-wrap: wrap; gap: 12px; }
.sec-ttl { font-size: 16px; font-weight: 600; color: var(--t1); display: flex; align-items: center; gap: 8px; }
.sec-ttl::before { content: ''; width: 4px; height: 16px; border-radius: 4px; background: var(--c); display: inline-block; }

/* ═══════════════════════════════════════════════════════════
   STAT CARDS (Responsive Grid)
═══════════════════════════════════════════════════════════ */
.stats-grid, .tgt-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 24px; }
.stat-card { padding: 20px; position: relative; }
.s-lbl { font-size: 13px; font-weight: 500; color: var(--t3); margin-bottom: 8px; }
.s-val { font-size: 28px; font-weight: 700; color: var(--t1); line-height: 1.2; margin-bottom: 4px; }
.s-sub { font-size: 12px; color: var(--t4); }
.s-ic { position: absolute; top: 20px; right: 20px; font-size: 20px; width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; }
.c1 .s-ic, .c1.s-val { color: var(--c); } .stat-card:has(.c1) .s-ic { background: var(--c3); }
.c2 .s-ic, .c2.s-val { color: var(--p); } .stat-card:has(.c2) .s-ic { background: rgba(139, 92, 246, 0.1); }
.c3 .s-ic, .c3.s-val { color: var(--g); } .stat-card:has(.c3) .s-ic { background: var(--g2); }
.c4 .s-ic, .c4.s-val { color: var(--y); } .stat-card:has(.c4) .s-ic { background: rgba(245, 158, 11, 0.1); }
.c5 .s-ic, .c5.s-val { color: var(--c2); } .stat-card:has(.c5) .s-ic { background: rgba(96, 165, 250, 0.1); }
.c6 .s-ic, .c6.s-val { color: var(--r); } .stat-card:has(.c6) .s-ic { background: rgba(239, 68, 68, 0.1); }

/* ═══════════════════════════════════════════════════════════
   BUTTONS (Unified System)
═══════════════════════════════════════════════════════════ */
.btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 8px 16px; border-radius: var(--r); font-family: var(--font); font-size: 13px; font-weight: 500; cursor: pointer; border: 1px solid transparent; transition: var(--tx); white-space: nowrap; }
.btn-primary { background: var(--c); color: #fff; box-shadow: 0 2px 4px var(--c3); }
.btn-primary:hover { background: var(--c2); transform: translateY(-1px); box-shadow: 0 4px 6px var(--c4); }
.btn-glass { background: var(--bg2); border-color: var(--border); color: var(--t2); }
.btn-glass:hover { background: var(--bg); border-color: var(--border2); color: var(--t1); }
.btn-danger { background: var(--bg2); border-color: #FCA5A5; color: var(--r); }
.btn-danger:hover { background: #FEF2F2; color: #DC2626; border-color: #F87171; }
.btn-solid-red { background: var(--r); color: #fff; }
.btn-solid-red:hover { background: #DC2626; box-shadow: 0 4px 6px rgba(239, 68, 68, 0.2); }
.btn-outline-red { border: 1px solid var(--r); color: var(--r); background: transparent; }
.btn-outline-red:hover { background: #FEF2F2; }
.btn-sm { padding: 6px 12px; font-size: 12px; }

/* ═══════════════════════════════════════════════════════════
   TABLES (Clean & Aligned)
═══════════════════════════════════════════════════════════ */
.tbl-scroll { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
.tbl-scroll::-webkit-scrollbar { height: 6px; }
.tbl-scroll::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 4px; }
table { width: 100%; min-width: 800px; border-collapse: collapse; text-align: left; }
th, td { padding: 14px 16px; border-bottom: 1px solid var(--border); vertical-align: middle; }
thead th { background: var(--bg3); color: var(--t3); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid var(--border); }
tbody tr { transition: var(--tx); }
tbody tr:hover { background: var(--bg); }
tbody td { font-size: 13px; color: var(--t2); }
tbody td:first-child { color: var(--t1); font-weight: 500; }
.num { font-variant-numeric: tabular-nums; }
.total-row td { background: var(--bg3); font-weight: 600; color: var(--t1); border-top: 2px solid var(--border2); }

/* ═══════════════════════════════════════════════════════════
   FORMS & INPUTS (Consistent height)
═══════════════════════════════════════════════════════════ */
.form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
.form-grid .full { grid-column: 1 / -1; }
.fg { display: flex; flex-direction: column; gap: 6px; }
.fg label { font-size: 12px; font-weight: 500; color: var(--t2); }
.fc, .flt-in, .mp-input, .mp-select, .fs-discount-input { width: 100%; height: 40px; padding: 0 12px; background: var(--bg2); border: 1px solid var(--border); border-radius: var(--r); font-size: 13px; color: var(--t1); outline: none; transition: var(--tx); }
.fc:focus, .flt-in:focus { border-color: var(--c); box-shadow: 0 0 0 3px var(--c3); }
.fc[readonly] { background: var(--bg); color: var(--t3); border-style: dashed; cursor: not-allowed; }

.flt-row, .chip-row { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 16px; align-items: center; }
.chip { display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: 20px; border: 1px solid var(--border); background: var(--bg2); font-size: 12px; font-weight: 500; color: var(--t2); cursor: pointer; transition: var(--tx); }
.chip:hover { background: var(--bg); border-color: var(--border2); }
.chip.on { background: var(--c3); border-color: var(--c); color: var(--c); font-weight: 600; }
.chip-n { background: var(--border); padding: 2px 6px; border-radius: 10px; font-size: 11px; }
.chip.on .chip-n { background: #fff; color: var(--c); }

/* ═══════════════════════════════════════════════════════════
   MODALS / POPUPS (Unified Design)
═══════════════════════════════════════════════════════════ */
.st-modal, #page-st-add, .mp-modal-overlay, .fs-modal-overlay { position: fixed; inset: 0; z-index: 100000; background: rgba(15, 23, 42, 0.4); backdrop-filter: blur(4px); display: flex; align-items: center; justify-content: center; padding: 20px; opacity: 0; pointer-events: none; transition: var(--tx); }
.st-modal.show, #page-st-add.active, .mp-modal-overlay.active, .fs-modal-overlay.show { opacity: 1; pointer-events: auto; }

.st-modal-box, #page-st-add .card, .mp-modal-container, .fs-modal-container { width: 100%; max-width: 800px; max-height: 90vh; overflow-y: auto; background: var(--bg2); border-radius: var(--r-lg); box-shadow: var(--sh-modal); display: flex; flex-direction: column; transform: scale(0.98); transition: var(--tx); border: 1px solid var(--border); }
.st-modal.show .st-modal-box, #page-st-add.active .card, .mp-modal-overlay.active .mp-modal-container, .fs-modal-overlay.show .fs-modal-container { transform: scale(1); }

.st-head-edit, .mp-modal-header, .fs-modal-header { padding: 20px 24px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; background: var(--bg2); position: sticky; top: 0; z-index: 10; border-radius: var(--r-lg) var(--r-lg) 0 0; margin-bottom: 0 !important; }
.st-close-btn, .mp-modal-close, .fs-modal-close { width: 32px; height: 32px; border: none; background: var(--bg); border-radius: 8px; color: var(--t3); font-size: 18px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: var(--tx); }
.st-close-btn:hover, .mp-modal-close:hover { background: #FEF2F2; color: var(--r); }

.mp-modal-body, .fs-modal-body, #page-st-add .form-grid { padding: 24px; }
.mp-modal-footer, .fs-modal-footer { padding: 16px 24px; border-top: 1px solid var(--border); background: var(--bg3); display: flex; justify-content: flex-end; gap: 12px; border-radius: 0 0 var(--r-lg) var(--r-lg); }

/* ═══════════════════════════════════════════════════════════
   PAGINATION
═══════════════════════════════════════════════════════════ */
.pag { display: flex; align-items: center; justify-content: space-between; padding: 16px 24px; border-top: 1px solid var(--border); background: var(--bg2); flex-wrap: wrap; gap: 16px; }
.pag-info { font-size: 13px; color: var(--t3); }
.pag-btns { display: flex; gap: 4px; }
.pag-btn { min-width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; background: var(--bg2); border: 1px solid var(--border); border-radius: 6px; font-size: 13px; color: var(--t2); cursor: pointer; transition: var(--tx); }
.pag-btn:hover:not(:disabled) { background: var(--bg); border-color: var(--border2); }
.pag-btn.on { background: var(--c); color: #fff; border-color: var(--c); }
.pag-btn:disabled { opacity: 0.5; cursor: not-allowed; }

/* ═══════════════════════════════════════════════════════════
   PERFORMA CHAT (Modern Aligned Cards)
═══════════════════════════════════════════════════════════ */
.pa-chat-footer-premium { display: flex; flex-wrap: wrap; gap: 16px; padding: 16px; background: var(--bg3); border-top: 1px solid var(--border); }
.pa-chat-card-inline { background: var(--bg2); border: 1px solid var(--border); border-radius: var(--r); padding: 16px 20px; flex: 1; min-width: 280px; display: flex; align-items: center; gap: 20px; box-shadow: var(--sh); }
.pa-card-title-inline { font-size: 13px; font-weight: 600; color: var(--t1); border-right: 1px solid var(--border); padding-right: 20px; display: flex; align-items: center; gap: 8px; white-space: nowrap; }
.right-card .pa-card-title-inline { border-right: none; padding-right: 0; }
.pa-legend-inline-wrap { display: flex; flex-wrap: wrap; gap: 16px; }
.pa-legend-item-inline { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--t2); }
.pa-dot { width: 10px; height: 10px; border-radius: 50%; }
.pa-dot.green { background: var(--g); } .pa-dot.red { background: var(--r); } .pa-dot.yellow { background: var(--y); } .pa-dot.gray { background: var(--t4); }
.pa-last-update-val-inline { font-size: 16px; font-weight: 700; color: var(--c); }

/* ═══════════════════════════════════════════════════════════
   BADGES & TOASTS
═══════════════════════════════════════════════════════════ */
.badge { display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 6px; font-size: 11px; font-weight: 600; letter-spacing: 0.3px; }
.b-ach { background: var(--g2); color: var(--g); }
.b-exc { background: var(--c3); color: var(--c); }
.b-mis { background: rgba(239, 68, 68, 0.1); color: var(--r); }

/* ═══════════════════════════════════════════════════════════
   SMART RESPONSIVE (MOBILE, TABLET, LAPTOP) 
   [DIADAPTASI AGAR RAPI DI SEMUA LAYAR]
═══════════════════════════════════════════════════════════ */
    /* --- 1. TABLET & LAPTOP KECIL (< 1024px) --- */
    @media (max-width: 1024px) {
    :root { --sb: 260px; }
  
    /* JURUS PAMUNGKAS: Tambahkan 'body' di depan agar menang mutlak atas kode manapun */
    body .main, 
    body .sidebar ~ .main, 
    body .sidebar.closed ~ .main { 
    margin-left: 0 !important; 
    padding-left: 0 !important;
    width: 100% !important; 
    max-width: 100vw !important;
  }
  
    .page-wrap { padding: 24px; } 
