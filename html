/* ═══════════════════════════════════════════════════════════
   FETCH ALL DATA
═══════════════════════════════════════════════════════════ */
async function fetchAll(manual=false){
  if(manual) toast('Memuat ulang data...','info');
  
  try {
    // 1. Siapkan semua request secara paralel (Termasuk IMC)
    const kcReq   = apiGet(CFG.apiKC, CFG.sheetKC).catch(() => null);
    
    // 2. Semua modul menggunakan API GABUNGAN (CFG.apiDATA)
    const stReq   = apiGet(CFG.apiDATA, CFG.sheetStock).catch(() => null);
    const fsReq   = apiGet(CFG.apiDATA, CFG.sheetFlashSale).catch(() => null);
    const rwReq   = apiGet(CFG.apiDATA, CFG.sheetRiwayat).catch(() => null);
    const pjReq   = apiGet(CFG.apiDATA, CFG.sheetPenjualan).catch(() => null);
    const onReq   = apiGet(CFG.apiDATA, CFG.sheetOnline).catch(() => null);
    const lvReq   = apiGet(CFG.apiDATA, CFG.sheetLive).catch(() => null);
    const offReq  = apiGet(CFG.apiDATA, CFG.sheetOffline).catch(() => null);
    const chatReq = apiGet(CFG.apiDATA, CFG.sheetChat).catch(() => null);

    // 3. Eksekusi semua request secara BERSAMAAN (Hemat waktu loading drastis!)
    const [kc, st, fsData, rwData, pj, on, lv, offData, chatData] = await Promise.all([
      kcReq, stReq, fsReq, rwReq, pjReq, onReq, lvReq, offReq, chatReq
    ]);

    // --- ASSIGN DATA IMC ---
    if(kc && Array.isArray(kc)) S.kc.data = kc.map(kcNorm);

    // --- ASSIGN DATA STOCK ---
    if(st && Array.isArray(st)) S.st.data = st.filter(r=>String(r['Id Produk']||'').trim()||String(r['Nama Produk']||'').trim());
    if(fsData && Array.isArray(fsData)) S.st.flashSale = fsData; else S.st.flashSale = [];
    if(rwData && Array.isArray(rwData)) S.st.riwayat = rwData.reverse(); else S.st.riwayat = [];

    // --- ASSIGN DATA PERFORMA ADMIN ---
    const handleDynamic = (val, stateKey) => {
        if (val && Array.isArray(val)) {
            S.pa[stateKey] = val;
        } else if (val && val.rows) {
            S.pa[stateKey] = val.rows;
            S.pa[stateKey + 'Headers'] = val.headers;
            if (val.setting && val.setting.length > 0) {
                S.pa.setting = val.setting;
            }
        } else {
            S.pa[stateKey] = [];
        }
    };

    if(pj && Array.isArray(pj)) S.pa.penjualan = pj;
    handleDynamic(on, 'online');
    handleDynamic(lv, 'live');
    handleDynamic(offData, 'offline');
    handleDynamic(chatData, 'chat');

    // 4. Render ke layar
    renderAll();
    if(manual) toast('Data berhasil diperbarui','ok');

  } catch(e) {
    console.error(e);
    toast('Terjadi kendala jaringan, beberapa data mungkin tidak termuat.','warn');
    renderAll();
  } finally {
    showLoad(false); 
  }
}
 
