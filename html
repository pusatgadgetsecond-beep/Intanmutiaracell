  const parseNum = (v) => {
    if (v === undefined || v === null || v === '-' || v === '') return 0;
    return parseInt(String(v).replace(/[^\d]/g, '')) || 0;
  };

  // Filter Data
  let filtered = data.filter(r => {
    const rawTgl = r[colTanggal] || r['tanggal'];
    if (!rawTgl) return false;
    const dt = parseTgl(rawTgl);
    if (!dt || isNaN(dt.getTime())) return false; 
    const matchBln = !bln || (dt.getMonth() + 1).toString() === bln;
    const matchThn = !thn || dt.getFullYear().toString() === thn;
    return matchBln && matchThn;
  });

  // Hitung Grand Total
  let grandTotalAll = 0;
  filtered.forEach(r => {
    colsMp.forEach(mp => { grandTotalAll += parseNum(r[mp]); });
  });

  const summaryEl = $('pa-onl-summary');
  if (summaryEl) {
    summaryEl.innerHTML = `
      <div class="card tgt-card"><div class="tgt-lbl">Total Penjualan Online</div>
        <div class="tgt-row"><span class="tgt-val">${fmt(grandTotalAll)}</span><span class="tgt-pct">Unit</span></div>
        <div class="tgt-meta" style="justify-content: flex-start; gap: 15px;">
          <span style="color:var(--c)">Akumulasi dari ${colsMp.length} Toko Online Tersedia</span>
        </div>
      </div>`;
  }

  const totalData = filtered.length;
  const totalPg = Math.max(1, Math.ceil(totalData / rpp));
  if (S.pa.onlPage > totalPg) S.pa.onlPage = totalPg;

  const startIndex = (S.pa.onlPage - 1) * rpp;
  const slice = filtered.slice(startIndex, startIndex + rpp);

  // Hitung Total Khusus Halaman Ini Saja
  let pageSemuaMp = {};
  colsMp.forEach(mp => pageSemuaMp[mp] = 0);
  let pageAll = 0;

  slice.forEach(r => {
    colsMp.forEach(mp => {
      let val = parseNum(r[mp]);
      pageSemuaMp[mp] += val;
      pageAll += val;
    });
  });

  const tb = $('pa-onl-tbody');
  if (!tb) return;

  if (!slice.length) {
    tb.innerHTML = `<tr><td colspan="${colsMp.length + 2}"><div class="empty"><div class="ei">📭</div><p>Tidak ada data penjualan online di periode ini</p></div></td></tr>`;
  } else {
    let htmlRows = slice.map(r => {
      let rawTgl = r[colTanggal] || r['tanggal'];
      let rowTotal = 0;
      let trHTML = `<tr><td data-label="Tanggal" style="font-weight:600; color:var(--t1)">${esc(formatTanggalTampilan(rawTgl))}</td>`;
      
      colsMp.forEach(mp => {
        let val = parseNum(r[mp]);
        rowTotal += val;
        trHTML += `<td data-label="${esc(mp)}" class="num">${fmt(val)}</td>`;
      });
      
      trHTML += `<td data-label="Total" class="num num-h">${fmt(rowTotal)}</td></tr>`;
      return trHTML;
    }).join('');

    // Baris Total Keseluruhan 
    let totalRowHTML = `
      <tr class="total-row">
        <td data-label="Keterangan" style="font-weight:800; color:var(--t1); text-transform:uppercase; letter-spacing:1px; text-align:left;">Total Keseluruhan:</td>`;
    
    const colors = ['var(--c)', 'var(--p)', 'var(--c)', 'var(--p)', 'var(--c)', 'var(--p)', 'var(--g)', 'var(--y)', 'var(--pur)', 'var(--r)'];
    colsMp.forEach((mp, i) => {
      totalRowHTML += `<td data-label="Tot. ${esc(mp)}" class="num" style="color:${colors[i % colors.length]}; font-weight:800;">${fmt(pageSemuaMp[mp])}</td>`;
    });
    totalRowHTML += `<td data-label="Grand Total" class="num num-h" style="font-size:14.5px; font-weight:800;">${fmt(pageAll)}</td></tr>`;

    tb.innerHTML = htmlRows + totalRowHTML;
  }

  const pinfo = $('pa-onl-pinfo');
  const pbtns = $('pa-onl-pbtns');
  if (pinfo) pinfo.textContent = `${totalData} transaksi · Hal ${S.pa.onlPage}/${totalPg}`;
  if (pbtns) renderPag('pa-onl-pbtns', S.pa.onlPage, totalPg, p => { S.pa.onlPage = p; renderPaOnline(); });
}
 
