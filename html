function renderPag(btnId, cur, total, cb){
  const el=$(btnId); if(!el) return;
  if(total<=1){ el.innerHTML=''; return; }
  
  // Memperbaiki nama fungsi agar tidak error (mengubah - menjadi _)
  const safeId = btnId.replace(/-/g, '_');
  
  let html=`<button class="pag-btn" onclick="cb_${safeId}(${cur-1})" ${cur<=1?'disabled':''}>‹</button>`;
  for(let i=1;i<=total;i++){
    if(i===1||i===total||(i>=cur-2&&i<=cur+2)){
      html+=`<button class="pag-btn${i===cur?' on':''}" onclick="cb_${safeId}(${i})">${i}</button>`;
    } else if(i===cur-3||i===cur+3) html+=`<span style="color:var(--t3);padding:0 3px;font-size:11px">…</span>`;
  }
  html+=`<button class="pag-btn" onclick="cb_${safeId}(${cur+1})" ${cur>=total?'disabled':''}>›</button>`;
  el.innerHTML=html;
  window[`cb_${safeId}`] = p => { if(p>=1&&p<=total) cb(p); };
}
 
function dlCsv(rows, filename){
  const csv=rows.map(r=>r.map(c=>`"${String(c).replace(/"/g,'""')}"`).join(',')).join('\n');
  const blob=new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8;'});
  const url=URL.createObjectURL(blob);
  const a=document.createElement('a'); a.href=url; a.download=filename; a.click(); URL.revokeObjectURL(url);
}
 
function hitungTotalDashboard(tipeData, targetBulan, targetTahun) {
  // 1. Prioritaskan ambil dari Global State, jika kosong ambil dari SessionStorage
  let data = S.pa[tipeData];
  if (!data || data.length === 0) {
    const cachedData = sessionStorage.getItem(`cache_pa_${tipeData}`);
    if (cachedData) {
      data = JSON.parse(cachedData);
      S.pa[tipeData] = data; // Kembalikan ke memori global
    } else {
      return 0; // Jika tidak ada data sama sekali, kembalikan 0
    }
  }

  // 2. Filter dan Jumlahkan (Sum)
  let grandTotal = 0;
  
  data.forEach(row => {
    // Ambil nilai tanggal dari row
    let rawTgl = row['Tanggal'] || row['tanggal'] || row['Date'];
    if (!rawTgl) return;

    // Parse tanggal menggunakan fungsi bantuanmu yang sudah ada
    let dt = parseTgl(rawTgl);
    if (!dt || isNaN(dt.getTime())) return;

    // Cek apakah bulan dan tahun cocok dengan target
    let matchBulan = (dt.getMonth() + 1).toString() === targetBulan.toString();
    let matchTahun = dt.getFullYear().toString() === targetTahun.toString();

    // Jika cocok, jumlahkan nilai kolom tokonya
    if (matchBulan && matchTahun) {
      Object.keys(row).forEach(key => {
        let kl = key.toLowerCase();
        // Abaikan kolom Tanggal, Keterangan, atau Total (kita hitung manual tokonya saja)
        if (kl !== 'tanggal' && kl !== 'date' && kl !== 'total' && kl !== '') {
           let val = parseInt(String(row[key]).replace(/[^\d]/g, '')) || 0;
           grandTotal += val;
        }
      });
    }
  });

  return grandTotal;
}

