/* =========================================================================
   LOGIKA DUPLIKAT FLASH SALE (SINGLE SOURCE OF TRUTH)
   ========================================================================= */

function parseCurrencyToNumber(val) {
  if (typeof val === 'number') return val;
  if (!val) return 0;
  return parseInt(String(val).replace(/[^0-9]/g, ''), 10) || 0;
}

function formatRupiah(angka) {
  return 'Rp ' + (angka || 0).toLocaleString('id-ID');
}

window.duplikatFlashSale = function(promoId) {
  // 1. Ambil Data Promo Lama dari State / Database
  const sourceData = (typeof S !== 'undefined' && S.st && S.st.flashSale) ||
                     window.flashSaleData || window.allData || window.tableData || 
                     window.rawSheetData || [];

  const dataLama = sourceData.filter(item => {
    const currentId = item["Promo ID"] || item.promoId || item[0];
    return String(currentId).trim().toUpperCase() === String(promoId).trim().toUpperCase();
  });

  if (!dataLama || dataLama.length === 0) {
    if (typeof Swal !== 'undefined') {
      Swal.fire({ icon: 'error', title: 'Gagal', text: 'Data promo tidak ditemukan.' });
    }
    return;
  }

  // 2. Buka Form Flash Sale menggunakan tombol "+ Buat" resmi (supaya modal & state awal ter-reset)
  const tombolBuat = document.getElementById('tombol-buat-flash'); 
  if (tombolBuat) {
    tombolBuat.click(); 
  } else if (typeof openModalFS === 'function') {
    openModalFS();
  } else {
    alert('Sistem tidak bisa menemukan tombol "+ Buat".');
    return;
  }

  // 3. Jeda sedikit agar proses reset modal bawaan tombol "+ Buat" selesai
  setTimeout(() => {
    // Inisialisasi/Reset State Terpusat Sistem
    if (typeof confirmedProductIds !== 'undefined') {
      confirmedProductIds.clear();
    } else {
      window.confirmedProductIds = new Set();
    }

    if (typeof tempSelectedProductIds !== 'undefined') {
      tempSelectedProductIds.clear();
    } else {
      window.tempSelectedProductIds = new Set();
    }

    window.flashSaleDiscounts = {};

    // Ambil/Pastikan Master Data Produk Real-Time
    const masterProducts = Array.isArray(REAL_PRODUCTS) && REAL_PRODUCTS.length > 0 ? REAL_PRODUCTS : [];

    dataLama.forEach(item => {
      const productId = String(item["Product ID"] || item.productId || item[4] || '').trim();
      let namaMentah = item["Nama Produk"] || item.namaProduk || item[5] || 'Tanpa Nama';
      
      let namaProduk = namaMentah;
      let variasi = item["Variasi"] || item.variasi || '-';
      const matchVariasi = namaMentah.match(/(.*)\((.*)\)/);
      if (matchVariasi) {
        namaProduk = matchVariasi[1].trim();
        variasi = matchVariasi[2].trim();
      }

      const hargaNormal = parseCurrencyToNumber(item["Harga Normal"] || item.hargaNormal || item[6]);
      const potongan = parseCurrencyToNumber(item["Potongan"] || item.potongan || item[7]);

      if (productId) {
        // Isi State Terpusat yang Digunakan Sistem
        confirmedProductIds.add(productId);
        tempSelectedProductIds.add(productId);
        window.flashSaleDiscounts[productId] = potongan;

        // Pastikan produk terdaftar di REAL_PRODUCTS agar dapat dibaca oleh renderSelectedProducts
        const existingIdx = masterProducts.findIndex(p => String(p.id) === productId);
        if (existingIdx === -1) {
          masterProducts.push({
            id: productId,
            name: namaProduk,
            variasi: variasi,
            price: formatRupiah(hargaNormal),
            stock: 99
          });
        }
      }
    });

    // Update Master Data Global jika sebelumnya kosong
    if (REAL_PRODUCTS.length === 0) {
      REAL_PRODUCTS = masterProducts;
    }

    // 4. PANGGIL FUNGSI RENDER BAWAAN "+ Buat" (Single Source of Truth)
    if (typeof window.renderSelectedProducts === 'function') {
      window.currentSelectedPage = 1; // Reset halaman pagination ke 1
      window.renderSelectedProducts();
    }

    // Update Counter Jumlah Produk di Footer Modal
    if (typeof updateFooterCount === 'function') {
      updateFooterCount();
    }

    // Reset Slot Waktu agar pengguna memilih slot baru
    window.tempSlotData = null;
    document.querySelectorAll('input[name="flash_sale_slot"]').forEach(r => r.checked = false);

  }, 400); 
};

/* =========================================================================
   FUNGSI KALKULASI & FORMAT (AGAR FITUR RUBAH POTONGAN BERJALAN)
   ========================================================================= */

window.formatInputRibuan = function(input) {
  let val = input.value.replace(/[^0-9]/g, '');
  if (val === '') {
    input.value = '';
    return;
  }
  input.value = parseInt(val, 10).toLocaleString('id-ID');
};

window.kalkulasiDiskonRealtime = function(productId) {
  const inputPotongan = document.getElementById(`input-potongan-${productId}`);
  const labelDiskon = document.getElementById(`label-diskon-${productId}`);
  const labelHargaNormal = document.getElementById(`harga-normal-${productId}`);

  if (!inputPotongan || !labelDiskon || !labelHargaNormal) return;

  const hargaNormal = parseCurrencyToNumber(labelHargaNormal.getAttribute('data-harga'));
  const potonganBaru = parseCurrencyToNumber(inputPotongan.value);
  const hargaDiskonBaru = Math.max(0, hargaNormal - potonganBaru);

  // Update tampilan
  labelDiskon.innerText = formatRupiah(hargaDiskonBaru);

  // Update data sistem agar saat disimpan nilainya ikut berubah
  const pIndex = window.REAL_PRODUCTS.findIndex(p => p.id === productId);
  if (pIndex !== -1) {
    window.REAL_PRODUCTS[pIndex].potongan = potonganBaru;
    window.REAL_PRODUCTS[pIndex].hargaDiskon = hargaDiskonBaru;
  }
  if (window.flashSaleDiscounts) {
    window.flashSaleDiscounts[productId] = potonganBaru;
  }
};

window.hapusProdukDariDuplikat = function(productId) {
  window.REAL_PRODUCTS = window.REAL_PRODUCTS.filter(p => p.id !== productId);
  if (window.confirmedProductIds) window.confirmedProductIds.delete(productId);
  if (window.tempSelectedProductIds) window.tempSelectedProductIds.delete(productId);
  if (window.flashSaleDiscounts) delete window.flashSaleDiscounts[productId];
  
  window.renderTabelProdukTerpilih();
  
  const selectedCountDisplay = document.getElementById('selectedCount');
  if (selectedCountDisplay) selectedCountDisplay.innerText = window.REAL_PRODUCTS.length;
};

