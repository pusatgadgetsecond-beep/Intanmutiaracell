/* ═══════════════════════════════════════════════════════════
   FETCH HELPERS (GAS COMPLIANT)
═══════════════════════════════════════════════════════════ */
async function apiGet(url, sheet=''){
  const u = sheet ? `${url}?action=read&sheet=${encodeURIComponent(sheet)}` : `${url}?action=read`;
  const r = await fetch(u, { redirect: "follow" });
  if(!r.ok) throw new Error(`HTTP ${r.status}`);
  return r.json();
}
async function apiPost(url, data, sheet=''){
  const r = await fetch(url,{
    method:'POST',
    body:JSON.stringify({ action: 'create', sheet: sheet, data: data })
  });
  if(!r.ok) throw new Error(`HTTP ${r.status}`);
  return r.json();
}
async function apiPatch(url, col, val, data, sheet=''){
  const r=await fetch(url,{
    method:'POST',
    body:JSON.stringify({ action: 'update', sheet: sheet, keyCol: col, keyVal: val, data: data })
  });
  if(!r.ok) throw new Error(`HTTP ${r.status}`);
  return r.json();
}
async function apiDel(url, col, val, sheet=''){
  const r=await fetch(url,{
    method:'POST',
    body:JSON.stringify({ action: 'delete', sheet: sheet, keyCol: col, keyVal: val })
  });
  if(!r.ok) throw new Error(`HTTP ${r.status}`);
