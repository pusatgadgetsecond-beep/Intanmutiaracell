window.kcSubmit = async function(){
  const judul=$('kc-judul')?.value.trim(), link=$('kc-link')?.value.trim();
  if(!judul||!link){ toast('Judul dan Link wajib diisi!','warn'); return; }
  const tglLocal=$('kc-tgl')?.value||'';
  let tgl=nowFmt();
  if(tglLocal){ const dt=new Date(tglLocal); const pad=n=>String(n).padStart(2,'0'); tgl=`${pad(dt.getDate())}/${pad(dt.getMonth()+1)}/${dt.getFullYear()} ${pad(dt.getHours())}:${pad(dt.getMinutes())}:${pad(dt.getSeconds())}`; }
  const payload={
    'Tanggal':tgl,'Link Konten':link,'Judul Konten':judul,
    'View':$('kc-view')?.value||'0',
    'Story Ig':$('kc-sig')?.value||'0',
    'Story Tk':$('kc-stk')?.value||'0',
  };
  Swal.fire({title:S.kc.editTgl?'Memperbarui...':'Menyimpan...',allowOutsideClick:false,background:'rgba(3,13,26,.97)',color:'#eff8ff',didOpen:()=>Swal.showLoading()});
  try{
    let res;
    if(S.kc.editTgl){
      res=await apiPatch(CFG.apiKC,'Tanggal',S.kc.editTgl,payload,CFG.sheetKC);
    } else {
      res=await apiPost(CFG.apiKC,payload,CFG.sheetKC);
    }
    
    if(res.error) throw new Error(res.error);
    Swal.fire({icon:'success',title:S.kc.editTgl?'Diperbarui!':'Tersimpan!',background:'rgba(3,13,26,.97)',color:'#eff8ff',confirmButtonColor:'#00b4d8',timer:1800,showConfirmButton:false});
    
    // === OPTIMASI LOKAL UPDATE (0 DETIK) ===
    const newData = kcNorm(payload); // Normalisasi payload agar sesuai dengan format array lokal
    if (S.kc.editTgl) {
      const idx = S.kc.data.findIndex(x => x.tanggal === S.kc.editTgl);
      if (idx !== -1) S.kc.data[idx] = newData;
    } else {
      S.kc.data.unshift(newData);
    }
    renderKcTable();
    renderKcDashboard();
    // =======================================

    kcReset();
  
  }catch(e){ Swal.fire({icon:'error',title:'Gagal',text:e.message,background:'rgba(3,13,26,.97)',color:'#eff8ff',confirmButtonColor:'#00b4d8'}); }
};
 
window.kcReset = function(){
