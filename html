// =========================================================================
// 1. HELPER: KONVERSI WAKTU (EXCEL TEXT FORMAT) <=> DETIK
// =========================================================================
function timeToSeconds(val) {
  if (!val) return 0;
  let str = val.toString().trim();
  
  // Jika formatnya angka desimal (terkadang Google Sheets mengirim waktu sbg pecahan)
  if (!str.includes(':') && !isNaN(parseFloat(str))) {
    return Math.round(parseFloat(str) * 24 * 3600);
  }
  
  // Jika formatnya string "HH:MM:SS"
  const parts = str.split(':');
  let secs = 0;
  if (parts.length >= 2) {
    let h = parseInt(parts[0]) || 0;
    let m = parseInt(parts[1]) || 0;
    let s = parseInt(parts[2]) || 0;
    secs = (h * 3600) + (m * 60) + s;
  }
  return secs;
}

function secondsToTime(secs) {
  const isNegative = secs < 0;
  secs = Math.abs(secs);
  const h = Math.floor(secs / 3600);
  const m = Math.floor((secs % 3600) / 60);
  const s = secs % 60;
  const pad = num => num.toString().padStart(2, '0');
  
  return (isNegative ? "-" : "") + `${h}:${pad(m)}:${pad(s)}`;
}

// =========================================================================
// 2. HTML GENERATOR: TABEL TARGET JAM TAYANG LIVE
// =========================================================================
function generateLiveTableRowHTML(host, targetSecs, terjualSecs, isTotal = false, bulan, tahun) {
  const styleTr = isTotal ? 'style="font-weight: bold; background-color: #f8fafc; border-top: 2px solid #e2e8f0; color: #0f172a;"' : 'style="border-bottom: 1px solid #f1f5f9;"';

  // --- LOGIKA SISA ---
  let sisaText = "Sama";
  if (terjualSecs > targetSecs) {
    sisaText = "+" + secondsToTime(terjualSecs - targetSecs);
  } else if (terjualSecs < targetSecs) {
    sisaText = "-" + secondsToTime(targetSecs - terjualSecs);
  }

  // --- LOGIKA PERSENTASE YANG DIPEBAIKI ---
  let pct = 0;
  if (targetSecs > 0) {
    pct = Math.round((terjualSecs / targetSecs) * 100);
    // Force ke 100 jika sudah lebih atau sama dengan target
    if (terjualSecs >= targetSecs) pct = 100;
  } else if (terjualSecs > 0 && targetSecs === 0) {
    pct = 100;
  }

  // UI Progress Bar
  let barWidth = pct; // Sudah aman di range 0-100
  let barColor = pct >= 100 ? '#10b981' : (pct >= 50 ? '#f59e0b' : '#ef4444');
  let pctHTML = `
    <div style="display: flex; align-items: center; gap: 8px;">
      <div style="width: 80px; background-color: #e2e8f0; border-radius: 99px; height: 7px; overflow: hidden;">
        <div style="width: ${barWidth}%; height: 100%; background-color: ${barColor}; border-radius: 99px;"></div>
      </div>
      <span style="font-size: 11px; font-weight: 600; color: #475569;">${pct}%</span>
    </div>
  `;

  // --- LOGIKA STATUS YANG DIPEBAIKI ---
  let statusText = "";
  let badgeClass = "";
  
  const sekarang = new Date();
  const bulanSekarang = sekarang.getMonth() + 1;
  const tahunSekarang = sekarang.getFullYear();
  const isBulanBerjalan = (parseInt(bulan) === bulanSekarang) && (parseInt(tahun) === tahunSekarang); 

  // Jika sudah mencapai target, label pasti Achieved +
  if (terjualSecs >= targetSecs && targetSecs > 0) {
    statusText = "Achieved +";
    badgeClass = "achieved";
  } 
  // Jika belum mencapai target tapi masih bulan berjalan, label Under Process
  else if (isBulanBerjalan) {
    statusText = "Under Process";
    badgeClass = "under-process";
  } 
  // Jika bulan sudah lewat dan belum mencapai target
  else {
    statusText = "Missed Target";
    badgeClass = "missed-target";
  }

  // Jika baris Total
  if (isTotal) {
    return `
      <tr ${styleTr}>
        <td>${host}</td>
        <td>${secondsToTime(targetSecs)}</td>
        <td style="color: #0ea5e9;">${secondsToTime(terjualSecs)}</td>
        <td>${sisaText}</td>
        <td>—</td>
        <td style="text-align: center;">—</td>
      </tr>
    `;
  }

  // Jika baris Normal
  return `
    <tr ${styleTr}>
      <td style="font-weight: 600; color: #334155;">${host}</td>
      <td style="color: #64748b;">${secondsToTime(targetSecs)}</td>
      <td style="font-weight: bold; color: ${terjualSecs >= targetSecs ? '#10b981' : (terjualSecs > 0 ? '#334155' : 'inherit')};">${secondsToTime(terjualSecs)}</td>
      <td style="color: ${terjualSecs >= targetSecs ? '#10b981' : '#ef4444'}; font-weight: 500;">${sisaText}</td>
      <td>${pctHTML}</td>
      <td><span class="badge ${badgeClass}">${statusText}</span></td>
    </tr>
  `;
}

