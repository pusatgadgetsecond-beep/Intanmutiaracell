function getFlashSaleStatus(slotWaktuStr) {
  if (!slotWaktuStr) return { l: '-', c: 'b-neu', s: '' };
  try {
    // Format ekspektasi: "25/06/2026 20:00 - 00:00"
    const parts = slotWaktuStr.split(' ');
    const dp = parts[0].split('/'); // [25, 06, 2026]
    const startTime = parts[1]; // "20:00"
    const endTime = parts[3]; // "00:00"

    const startD = new Date(`${dp[2]}-${dp[1]}-${dp[0]}T${startTime}:00`);
    let endD = new Date(`${dp[2]}-${dp[1]}-${dp[0]}T${endTime}:00`);
    
    // Jika jam selesai 00:00, berarti pergantian hari (besoknya)
    if (endTime === "00:00") endD.setDate(endD.getDate() + 1);

    const now = new Date();
    if (now < startD) {
      return { l: 'Akan Datang', c: 'b-ig', s: 'color: #f97316; border-color: rgba(249,115,22,.3); background: rgba(249,115,22,.1);' };
    }
    if (now >= startD && now <= endD) {
      return { l: 'Sedang Berjalan', c: 'b-ach', s: '' };
    }
    return { l: 'Telah Berakhir', c: 'b-neu', s: '' };
  } catch (e) {
    return { l: 'Error', c: 'b-neu', s: '' };
  }
}

let fsFilter = "semua";
window.renderFlashSaleTable = function() {
  const tb = document.getElementById('fs-promo-tbody');
  if (!tb) return;

  // Grouping data berdasarkan Promo ID (Aman, tidak merusak data sheet)
  const groupedPromo = {};
  if (S.st.flashSale && S.st.flashSale.length > 0) {
    S.st.flashSale.forEach(r => {
      const pid = r['Promo ID'] || r['promo id'];
      if (!pid) return;
      
      if (!groupedPromo[pid]) {
        groupedPromo[pid] = {
          promoId: pid,
          slotWaktu: r['Slot Waktu'] || r['slot waktu'],
          itemCount: 1
        };
      } else {
        groupedPromo[pid].itemCount++;
      }
    });
  }

  // Urutkan promo terbaru di atas (Berdasarkan ID)
  let promoList = Object.values(groupedPromo).reverse();
  let cSemua = promoList.length;
  let cBerjalan = 0;
  let cAkan = 0;
  let cAkhir = 0;

  promoList.forEach(p => {
    let st = getFlashSaleStatus(p.slotWaktu).l;
    if(st === "Sedang Berjalan") cBerjalan++;
    if(st === "Akan Datang") cAkan++;
    if(st === "Telah Berakhir") cAkhir++;
  });

  // Update angka badge pada Tab HTML
  document.getElementById("cnt-semua").innerText = cSemua;
  document.getElementById("cnt-berjalan").innerText = cBerjalan;
  document.getElementById("cnt-akan").innerText = cAkan;
  document.getElementById("cnt-akhir").innerText = cAkhir;

  // Filter List sesuai Tab Aktif
  promoList = promoList.filter(p => {
    let st = getFlashSaleStatus(p.slotWaktu).l;
    if(fsFilter === "semua") return true;
    if(fsFilter === "berjalan") return st === "Sedang Berjalan";
    if(fsFilter === "akan") return st === "Akan Datang";
    if(fsFilter === "akhir") return st === "Telah Berakhir";
  });

  // ════════════════════════════════════════════════════════════════
  // LOGIKA EMPTY STATE DINAMIS (Pesan berubah sesuai Tab)
  // ════════════════════════════════════════════════════════════════
  if (promoList.length === 0) {
    let emptyMsg = "Belum ada promosi Flash Sale";
    
    if (fsFilter === "berjalan") emptyMsg = "Belum Ada Sesi Yang Sedang Berjalan";
    else if (fsFilter === "akan") emptyMsg = "Belum Ada Sesi Yang Di Daftarkan";
    else if (fsFilter === "akhir") emptyMsg = "Belum Ada Sesi Yang Telah Berakhir";

    tb.innerHTML = `
      <tr>
        <td colspan="4" class="empty-state-cell">
          <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; min-height: 200px; text-align: center;">
            <div style="font-size: 42px; margin-bottom: 12px; line-height: 1;">⚡</div>
            <p style="margin: 0; font-size: 14px; font-weight: 500; color: var(--t3);">${emptyMsg}</p>
          </div>
        </td>
      </tr>
    `;
    return; // Hentikan fungsi sampai di sini karena data kosong
  }
  // ════════════════════════════════════════════════════════════════

  // Render Baris Data ke Tabel jika ada datanya
  tb.innerHTML = promoList.map(promo => {
    const stat = getFlashSaleStatus(promo.slotWaktu);
    return `
      <tr>
        <td data-label="Sesi">
          <div style="font-family: var(--mono); font-size: 11px; font-weight: 700; color: var(--c);">${promo.promoId}</div>
          <div style="font-family: var(--mono); font-size: 10.5px; margin-top: 4px;">${esc(promo.slotWaktu)}</div>
        </td>
        <td data-label="Produk">
          <div style="font-weight:700; font-size:12px; color:var(--t1);">
            Aktifkan untuk Flash Sale Toko Saya ${promo.itemCount}
          </div>
          <div style="font-size:10px; color:var(--t3); margin-top:4px;">
            Tersisa ${15 - promo.itemCount}
          </div>
        </td>
        <td data-label="Status">
          <span class="badge ${stat.c}" style="${stat.s}">${stat.l}</span>
        </td>
        <td data-label="Aksi">
          <div class="fs-action-links">
            <a href="javascript:void(0)" onclick="toast('Fitur rincian sedang dikembangkan', 'info')">Rincian</a>
            <a href="javascript:void(0)" onclick="duplikatFlashSale('${promo.promoId}')">Duplikat</a>
        </td>
      </tr>
    `;
  }).join('');
};

