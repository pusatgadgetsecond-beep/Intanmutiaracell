function kcNorm(r){
  const link = r['Link Konten']||r['link konten']||r['link']||'';
  const plat = r['Platform']||r['platform']||(link.includes('tiktok')?'TikTok':'Instagram');
  return {
    tanggal: r['Tanggal']||r['tanggal']||'',
    link, plat,
    judul: r['Judul Konten']||r['judul konten']||r['judul']||'',
    view:    parseInt(r['View']||r['view']||0),
    storyIg: parseInt(r['Story Ig']||r['Story IG']||0),
    storyTk: parseInt(r['Story Tk']||r['Story TK']||0),
  };
}
 
