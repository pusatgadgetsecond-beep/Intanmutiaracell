    document.querySelectorAll('input[name="flash_sale_slot"]').forEach(radio => radio.checked = false);

    if (typeof window.renderSelectedProducts === 'function') window.renderSelectedProducts();
    if (typeof updateFooterCount === 'function') updateFooterCount();

    renderCalendar();
    updateSessionsVisibility();
    updatePilihProdukState(); // 🟢 Sinkronisasi state tombol saat di-reset
  };

  // 3. EVENT LISTENER BUKA/TUTUP MODAL
  triggerButtons.forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      modalOverlay.classList.add('show');
      updatePilihProdukState(); // 🟢 Aturan 1: Cek status tombol begitu modal dibuka
    });
  });

  const closeModal = () => {
    modalOverlay.classList.remove('show');
    setTimeout(() => {
      if (!window.tempSlotData) {
        document.querySelectorAll('input[name="flash_sale_slot"]').forEach(r => r.checked = false);
      } else {
        document.querySelectorAll('input[name="flash_sale_slot"]').forEach(r => {
          r.checked = (r.value === window.tempSlotData.slot && tempSelectedDate.toDateString() === window.tempSlotData.date);
        });
      }
      updatePilihProdukState(); // 🟢 Aturan 4: Sinkronisasi saat modal ditutup/batal
    }, 300);
  };

  if (btnCloseX) btnCloseX.addEventListener('click', closeModal);
  if (btnCancel) btnCancel.addEventListener('click', closeModal);
  if (modalOverlay) {
    modalOverlay.addEventListener('click', (e) => {
      if (e.target === modalOverlay) closeModal();
    });
  }

  // 4. RENDER KALENDER
  function renderCalendar() {
    if (!calDaysContainer || !calMonthYearDisplay) return;
    calDaysContainer.innerHTML = '';
    calMonthYearDisplay.textContent = `${monthNames[currentMonth]} ${currentYear}`;

    const firstDayIndex = new Date(currentYear, currentMonth, 1).getDay();
    const totalDays = new Date(currentYear, currentMonth + 1, 0).getDate();
    const absoluteToday = new Date(new Date().getFullYear(), new Date().getMonth(), new Date().getDate());

    for (let i = 0; i < firstDayIndex; i++) calDaysContainer.appendChild(document.createElement('div'));

    for (let day = 1; day <= totalDays; day++) {
      const dayCell = document.createElement('div');
      dayCell.classList.add('fs-day-cell');
      dayCell.textContent = day;

      const thisCellDate = new Date(currentYear, currentMonth, day);

      if (thisCellDate < absoluteToday) {
        dayCell.classList.add('disabled');
      } else {
        if (thisCellDate.getTime() === tempSelectedDate.getTime()) {
          dayCell.classList.add('active');
          const indicator = document.createElement('span');
          indicator.classList.add('slot-indicator');
          indicator.textContent = 'Pilih Sesi';
          dayCell.appendChild(indicator);
        }
        dayCell.addEventListener('click', () => {
          tempSelectedDate = thisCellDate;
          renderCalendar();
          updateSessionsVisibility();
          document.querySelectorAll('input[name="flash_sale_slot"]').forEach(r => r.checked = false);
          updatePilihProdukState(); // 🟢 Aturan 3: Kunci kembali tombol saat tanggal diganti
        });
      }
      calDaysContainer.appendChild(dayCell);
    }
  }

  if (calPrevBtn) {
    calPrevBtn.addEventListener('click', () => {
      currentMonth--;
      if (currentMonth < 0) { currentMonth = 11; currentYear--; }
      renderCalendar();
    });
  }

  if (calNextBtn) {
    calNextBtn.addEventListener('click', () => {
      currentMonth++;
      if (currentMonth > 11) { currentMonth = 0; currentYear++; }
      renderCalendar();
    });
  }

  // 5. STATUS DISABLE SLOT WAKTU
  function updateSessionsVisibility() {
    const now = new Date();
    const currentHour = now.getHours();
    const isTodaySelected = (tempSelectedDate.toDateString() === now.toDateString());
    
    let dynamicVisibleCount = 0;

    sessionRows.forEach(row => {
      const startHour = parseInt(row.getAttribute('data-start-hour'), 10);
      const radioInput = row.querySelector('input[type="radio"]');
      
      const statusSesi = row.querySelector('.status-sesi'); 
      const badgeQuota = row.querySelector('.badge');       
      
      let isExpired = (isTodaySelected && currentHour >= startHour);
      
      const usedProductsDB = typeof window.getUsedProductsInSlot === 'function' 
        ? window.getUsedProductsInSlot(tempSelectedDate, radioInput.value) 
        : [];
      const isBooked = (usedProductsDB.length > 0) || bookedSlots.some(b => 
        b.date === tempSelectedDate.toDateString() && b.slot === radioInput.value
      );

      if (isExpired) {
        row.style.display = 'none';
        if (radioInput) radioInput.checked = false;
      } else {
        row.style.display = '';
        dynamicVisibleCount++;
        
        if (isBooked) {
          row.classList.add('disabled-slot');
          if (radioInput) {
            radioInput.disabled = true;
            radioInput.checked = false;
          }
          row.style.opacity = '0.6'; 
          row.style.pointerEvents = 'none'; 
          row.style.backgroundColor = 'var(--bg)'; 
          
          if (statusSesi) { 
            statusSesi.innerHTML = '🔒 Dijadwalkan'; 
            statusSesi.className = 'status-sesi status-dijadwalkan'; 
          }
          if (badgeQuota) {
            badgeQuota.innerHTML = 'Penuh';
            badgeQuota.className = 'badge b-neu';
          }
        } else {
          row.classList.remove('disabled-slot');
          if (radioInput) radioInput.disabled = false;
          row.style.opacity = '1';
          row.style.pointerEvents = ''; 
          row.style.backgroundColor = 'transparent';
          
          if (statusSesi) { 
            statusSesi.innerHTML = '✅ Tersedia'; 
            statusSesi.className = 'status-sesi status-tersedia'; 
          }
          if (badgeQuota) {
            const sisa = 15 - usedProductsDB.length;
            badgeQuota.innerHTML = `Tersisa ${sisa}`;
            badgeQuota.className = 'badge b-pro';
          }
        }
      }
    });

    if (dynamicVisibleCount === 0) {
      if (noSessionMsg) noSessionMsg.style.display = 'block';
      const table = document.querySelector('.fs-session-table');
      if (table) table.style.display = 'none';
    } else {
      if (noSessionMsg) noSessionMsg.style.display = 'none';
      const table = document.querySelector('.fs-session-table');
      if (table) table.style.display = 'table';
    }
  }

  // 6. KONFIRMASI SIMPAN SLOT DRAFT
  if (btnConfirm) {
    btnConfirm.addEventListener('click', () => {
      const checkedRadio = document.querySelector('input[name="flash_sale_slot"]:checked');
      if (!checkedRadio) {
        return Swal.fire({ icon: 'warning', title: 'Slot Belum Dipilih', text: 'Silakan pilih slot sesi terlebih dahulu.', confirmButtonColor: '#ef4444' });
      }

      window.tempSlotData = {
        date: tempSelectedDate.toDateString(),
        slot: checkedRadio.value
      };

      const dd = String(tempSelectedDate.getDate()).padStart(2, '0');
      const mm = String(tempSelectedDate.getMonth() + 1).padStart(2, '0');
      const times = checkedRadio.value.split(' - ');
      const dynamicText = `📅 ${dd}/${mm}/${tempSelectedDate.getFullYear()} &nbsp; ${times[0].substring(0, 5)} ~ ${times[1].substring(0, 5)}`;
      
      triggerButtons.forEach(btn => {
        btn.innerHTML = dynamicText;
        btn.classList.add('btn-fs-selected'); 
      });

      Swal.fire({ icon: 'success', title: 'Slot Dipilih!', html: `Jadwal sementara tersimpan.`, confirmButtonColor: '#22D3A5', timer: 2000, showConfirmButton: false });
      modalOverlay.classList.remove('show');
    });
  }

  // 🟢 LOGIKA BARU: Event listener untuk mendeteksi pemilihan baris dan radio button (Aturan 2)
  sessionRows.forEach(row => {
    row.addEventListener('click', (e) => {
      const radio = row.querySelector('input[type="radio"]');
      if (e.target.tagName !== 'INPUT' && radio && !radio.disabled && row.style.display !== 'none') {
        radio.checked = true;
      }
      updatePilihProdukState(); // Aktifkan tombol saat baris diklik
    });

    const radio = row.querySelector('input[type="radio"]');
    if (radio) {
      radio.addEventListener('change', updatePilihProdukState); // Aktifkan tombol saat radio berubah
    }
  });

  // Jalankan render awal saat halaman dimuat
  renderCalendar();
  updateSessionsVisibility();
  updatePilihProdukState(); // 🟢 Aturan 1: Pastikan tombol terkunci pada kondisi awal
});

/* =========================================================================
   JS UTALITAS MODAL SELLER CENTER "PILIH PRODUK" (FIX DUPLIKASI)
   ========================================================================= */
let REAL_PRODUCTS = []; 
// PERBAIKAN 1: Pisahkan State Permanen dan Sementara
let confirmedProductIds = new Set();    // Data produk yang sudah masuk Flash Sale
let tempSelectedProductIds = new Set(); // Data pilihan sementara di modal
let filteredProducts = [];
let currentPage = 1;
const itemsPerPage = 10;

const modal = document.getElementById('modalPilihProduk');
const btnBuka = document.getElementById('btnBukaModalProduk'); 
const btnClose = document.getElementById('btnCloseModal');
const btnBatal = document.getElementById('btnBatalModal');
const btnKonfirmasi = document.getElementById('btnKonfirmasiModal');
const tableBody = document.getElementById('productTableBody');
const chkSelectAll = document.getElementById('chkSelectAll');
const selectedCountEl = document.getElementById('selectedCount');
const filterKategori = document.getElementById('filterKategori');

async function fetchProductsFromSheet() {
  tableBody.innerHTML = `<tr><td colspan="4" style="text-align:center; padding:50px;">
    <div class="spinner" style="border-top-color: var(--c); margin-bottom:10px;"></div>
    <br><span style="color:var(--t3); font-family:var(--mono); font-size:11px;">Mengambil data stok real-time...</span>
  </td></tr>`;
  try {
    const response = await fetch(CFG.apiDATA + '?action=read&sheet=' + CFG.sheetStock);
    const data = await response.json();
    if (data.error) throw new Error(data.error);

    REAL_PRODUCTS = data.map(item => {
      let hargaSheet = (item['Harga Terbaru'] || item['Harga Jual Saat Ini'] || 'Rp 0').trim();
      if (!hargaSheet.startsWith('Rp')) hargaSheet = 'Rp ' + hargaSheet;
      return {
        id: item['Id Produk'] || '',
        name: item['Nama Produk'] || '',
        variasi: item['Nama Variasi'] || '',
        category: item['Kategori'] || 'Uncategorized',
        price: hargaSheet,
        stock: parseInt(item['Stok Lama'] || 0)
      };
    }).filter(item => item.id !== '' && item.name !== '');

    filteredProducts = [...REAL_PRODUCTS];
    populateCategoryDropdown();
    currentPage = 1;
    renderTable();
  } catch (error) {
    tableBody.innerHTML = `<tr><td colspan="4" style="text-align:center; padding:40px; color:var(--r);">⚠️ Gagal memuat data: ${error.message}</td></tr>`;
  }
}

function populateCategoryDropdown() {
  const uniqueCategories = [...new Set(REAL_PRODUCTS.map(p => p.category))].filter(c => c !== 'Uncategorized');
  let optionsHTML = `<option value="">Semua Kategori</option>`;
  uniqueCategories.forEach(cat => { optionsHTML += `<option value="${cat}">${cat}</option>`; });
  filterKategori.innerHTML = optionsHTML;
}

// PERBAIKAN 2: Jangan reset data yang sudah dikonfirmasi
function openModal() {
  modal.classList.add('active');
  
  // Salin data yang sudah confirmed ke temporary state agar checkbox tetap tercentang
  tempSelectedProductIds = new Set(confirmedProductIds);
  
  fetchProductsFromSheet();
  updateFooterCount();
}

function closeModalPilihProduk() { modal.classList.remove('active'); }

if(btnBuka) btnBuka.addEventListener('click', openModal);
btnClose.addEventListener('click', closeModalPilihProduk);
btnBatal.addEventListener('click', closeModalPilihProduk); // Jika batal, tempSelectedProductIds diabaikan
modal.addEventListener('click', (e) => { if (e.target === modal) closeModalPilihProduk(); });

document.querySelectorAll('.mp-tab-btn').forEach(button => {
  button.addEventListener('click', () => {
    document.querySelectorAll('.mp-tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.mp-tab-content').forEach(c => c.classList.remove('active'));
    button.classList.add('active');
    const tabId = `tabContent${button.dataset.tab.charAt(0).toUpperCase() + button.dataset.tab.slice(1)}`;
    document.getElementById(tabId).classList.add('active');
  });
});

// PERBAIKAN 3: Render tabel dengan validasi Rule 2 (Cek Database)
function renderTable() {
  const startIndex = (currentPage - 1) * itemsPerPage;
  const endIndex = startIndex + itemsPerPage;
  const pageItems = filteredProducts.slice(startIndex, endIndex);
  tableBody.innerHTML = '';
  
  if (pageItems.length === 0) {
    tableBody.innerHTML = `<tr><td colspan="4" style="text-align:center; padding:40px; color:var(--t3);">Produk tidak ditemukan.</td></tr>`;
    updatePaginationControls(0);
    return;
  }

  // --- AMBIL DAFTAR PRODUK YANG SUDAH DIPAKAI DI SLOT TERPILIH DARI DB ---
  let usedProductsInSlot = [];
  if (window.tempSlotData) {
     const d = new Date(window.tempSlotData.date);
     usedProductsInSlot = window.getUsedProductsInSlot(d, window.tempSlotData.slot);
  }
  
  pageItems.forEach(item => {
    const pIdStr = String(item.id);
    
    // Cek status kepemilikan produk (Sementara vs Database)
    const isConfirmed = confirmedProductIds.has(pIdStr);
    const isTempSelected = tempSelectedProductIds.has(pIdStr);
    const isUsedInDB = usedProductsInSlot.includes(pIdStr); // RULE 2: Terdaftar di waktu yang sama
    
    // Jika sudah terkonfirmasi permanen ATAU terpakai di DB, matikan Checkbox
    const isDisabled = (isConfirmed || isUsedInDB) ? 'disabled' : '';
    // Centang jika sudah terkonfirmasi ATAU dipilih sementara ATAU terpakai di DB
    const isChecked = (isConfirmed || isTempSelected || isUsedInDB) ? 'checked' : '';
    
    const isReady = item.stock > 0;
    const stockHTML = isReady ? `<span class="mp-p-stok ready">${item.stock} Ready</span>` : `<span class="mp-p-stok empty">Habis</span>`;
    const namaTampil = item.variasi && item.variasi !== '—' ? `${item.name} <span style="color:var(--c); font-size:10px;">(${item.variasi})</span>` : item.name;
    
    const row = document.createElement('tr');
    
    // Beri class CSS abu-abu jika produk sudah ada di Flash Sale saat ini ATAU di Database
    if (isConfirmed || isUsedInDB) {
      row.classList.add('disabled-row');
    }
    
    // Beri Label Merah jika produk tidak bisa dipilih karena sudah masuk slot
    const dbMarker = isUsedInDB ? `<div style="font-size:10px; color:var(--r); font-weight:600; margin-top:3px;">Terpakai di sesi ini</div>` : ``;

    row.innerHTML = `
      <td><input type="checkbox" class="mp-prod-chk" data-id="${item.id}" value="${item.id}" ${isChecked} ${isDisabled}></td>
      <td><div class="mp-p-name">${namaTampil}</div><div class="mp-p-id">ID: ${item.id}</div>${dbMarker}</td>
      <td><b style="color:var(--t1); font-family:var(--mono);">${item.price}</b></td>
      <td>${stockHTML}</td>
    `;
    tableBody.appendChild(row);
  });
  
  syncSelectAllCheckbox(pageItems, usedProductsInSlot);
  bindRowCheckboxes();
  updatePaginationControls(filteredProducts.length);
}

// PERBAIKAN 4: Proteksi Logika Checkbox
function bindRowCheckboxes() {
  document.querySelectorAll('.mp-prod-chk').forEach(chk => {
    chk.addEventListener('change', (e) => {
      const pId = String(e.target.dataset.id);
      
      let usedProductsInSlot = [];
      if (window.tempSlotData) {
         const d = new Date(window.tempSlotData.date);
         usedProductsInSlot = window.getUsedProductsInSlot(d, window.tempSlotData.slot);
      }

      // Abaikan klik jika produk sudah terkonfirmasi atau masuk di Database
      if (confirmedProductIds.has(pId) || usedProductsInSlot.includes(pId)) {
        e.target.checked = true; // Paksa kembali checked
        return;
      }

      if (e.target.checked) {
        // PERBAIKAN (Pindahkan return ke bawah):
      if (tempSelectedProductIds.size >= 15) {
      e.target.checked = false;
      Swal.fire({ icon: 'warning', title: 'Batas Maksimum', text: 'Maksimal 15 produk!', confirmButtonColor: '#ff6b00', target: document.body, allowOutsideClick: false });
      return;
      }
        tempSelectedProductIds.add(pId);
      } else {
        tempSelectedProductIds.delete(pId);
      }
      updateFooterCount();
      syncSelectAllCheckbox(filteredProducts.slice((currentPage - 1) * itemsPerPage, currentPage * itemsPerPage), usedProductsInSlot);
    });
  });
}

function syncSelectAllCheckbox(pageItems, usedProductsInSlot = []) {
  if(pageItems.length === 0) { chkSelectAll.checked = false; return; }
  // Select All aktif jika semua item di halaman sudah tercentang (baik sementara, konfirm, atau sudah di DB)
  chkSelectAll.checked = pageItems.every(item => 
    tempSelectedProductIds.has(String(item.id)) || 
    confirmedProductIds.has(String(item.id)) || 
    usedProductsInSlot.includes(String(item.id))
  );
}

// PERBAIKAN 5: Logika Select All (Jangan ganggu Database & Konfirmasi)
chkSelectAll.addEventListener('change', (e) => {
  const pageItems = filteredProducts.slice((currentPage - 1) * itemsPerPage, currentPage * itemsPerPage);
  
  let usedProductsInSlot = [];
  if (window.tempSlotData) {
     const d = new Date(window.tempSlotData.date);
     usedProductsInSlot = window.getUsedProductsInSlot(d, window.tempSlotData.slot);
  }

  if (e.target.checked) {
    for (let item of pageItems) {
      const pIdStr = String(item.id);
      if (!confirmedProductIds.has(pIdStr) && !tempSelectedProductIds.has(pIdStr) && !usedProductsInSlot.includes(pIdStr)) {
        if (tempSelectedProductIds.size >= 15) {
          Swal.fire({ icon: 'warning', title: 'Batas Maksimal', text: 'Batas 15 produk tercapai.', confirmButtonColor: '#ff6b00', target: document.body, allowOutsideClick: false });
          break;
        }
        tempSelectedProductIds.add(pIdStr);
      }
    }
  } else {
    pageItems.forEach(item => {
      const pIdStr = String(item.id);
      // Hanya bisa un-check produk yang belum terkonfirmasi DAN belum masuk di DB
      if (!confirmedProductIds.has(pIdStr) && !usedProductsInSlot.includes(pIdStr)) {
        tempSelectedProductIds.delete(pIdStr);
      }
    });
  }
  renderTable();
  updateFooterCount();
});

function updateFooterCount() { 
  selectedCountEl.textContent = tempSelectedProductIds.size; 
}

function applyFilters() {
  const katValue = document.getElementById('filterKategori').value;
  const tipeSearch = document.getElementById('filterCariTipe').value;
  const keyword = document.getElementById('inputSearch').value.toLowerCase().trim();
  const hanyaTersedia = document.getElementById('chkHanyaTersedia').checked;
  filteredProducts = REAL_PRODUCTS.filter(product => {
    if (katValue && product.category !== katValue) return false;
    if (keyword) {
      if (tipeSearch === 'nama' && !product.name.toLowerCase().includes(keyword)) return false;
      if (tipeSearch === 'id' && !product.id.toLowerCase().includes(keyword)) return false;
    }
    if (hanyaTersedia && product.stock <= 0) return false;
    return true;
  });
  currentPage = 1; renderTable();
}

function resetFilters() {
  document.getElementById('filterKategori').value = "";
  document.getElementById('filterCariTipe').value = "nama";
  document.getElementById('inputSearch').value = "";
  document.getElementById('chkHanyaTersedia').checked = false;
  filteredProducts = [...REAL_PRODUCTS];
  currentPage = 1; renderTable();
}

document.getElementById('btnCariProduk').addEventListener('click', applyFilters);
document.getElementById('btnResetFilter').addEventListener('click', resetFilters);
document.getElementById('inputSearch').addEventListener('keyup', (e) => { if (e.key === 'Enter') applyFilters(); });

document.getElementById('btnPrevPage').addEventListener('click', () => {
  if (currentPage > 1) {
    currentPage--;
    renderTable();
  }
});

document.getElementById('btnNextPage').addEventListener('click', () => {
  const totalPages = Math.ceil(filteredProducts.length / itemsPerPage);

  if (currentPage < totalPages) {
    currentPage++;
    renderTable();
  }
});

function updatePaginationControls(totalItems) {
  const totalPages = Math.ceil(totalItems / itemsPerPage) || 1;
  document.getElementById('paginationInfo').textContent = `Menampilkan ${totalItems === 0 ? 0 : (currentPage - 1) * itemsPerPage + 1}-${Math.min(currentPage * itemsPerPage, totalItems)} dari ${totalItems} produk`;
  document.getElementById('btnPrevPage').disabled = (currentPage === 1);
  document.getElementById('btnNextPage').disabled = (currentPage === totalPages);
  
  const pagNumbersEl = document.getElementById('pagNumbers');
  pagNumbersEl.innerHTML = '';
  const maxVisible = 5; 
  let startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
  let endPage = startPage + maxVisible - 1;
  if (endPage > totalPages) { endPage = totalPages; startPage = Math.max(1, endPage - maxVisible + 1); }
  
  for(let i = startPage; i <= endPage; i++) {
    const numBtn = document.createElement('button');
    numBtn.className = `mp-pag-num ${i === currentPage ? 'active' : ''}`;
    numBtn.textContent = i;
    numBtn.addEventListener('click', () => { currentPage = i; renderTable(); });
    pagNumbersEl.appendChild(numBtn);
  }
}

// PERBAIKAN 6: Tombol Konfirmasi Sementara di Modal
btnKonfirmasi.addEventListener('click', () => {
  if (tempSelectedProductIds.size === 0) {
    Swal.fire({ icon: 'info', title: 'Kosong', text: 'Pilih minimal 1 produk.', confirmButtonColor: 'var(--c)', background: 'rgba(3,13,26,.97)', color: '#eff8ff' });
    return;
  }
  
  // Pindahkan semua pilihan ke state Konfirmasi
  confirmedProductIds = new Set(tempSelectedProductIds);
  
  window.renderSelectedProducts();
  closeModalPilihProduk();
  toast(`${confirmedProductIds.size} produk siap untuk dipromosikan`, 'ok');
});

/* =========================================================================
   LOGIKA RENDER PRODUK TERPILIH & KONFIRMASI PRODUK (DENGAN PAGINATION)
========================================================================= */
const selectedContainer = document.getElementById('selected-products-container');

function cleanRupiah(str) { return parseInt(String(str).replace(/[^0-9]/g, '')) || 0; }
function toRupiah(num) { return 'Rp ' + Number(num).toLocaleString('id-ID'); }

window.renderSelectedProducts = function() {
  selectedContainer.innerHTML = ''; 
  
  // Render berdasarkan `confirmedProductIds`
  if (confirmedProductIds.size === 0) {
    selectedContainer.className = '';
    selectedContainer.style.border = 'none';
    return;
  }

  selectedContainer.className = 'card';
  selectedContainer.style.padding = '0';
  selectedContainer.style.marginTop = '18px';
  selectedContainer.style.overflow = 'hidden';

  const allSelected = Array.from(confirmedProductIds);
  const totalItems = allSelected.length;
  
  // 🟢 PERUBAHAN: Batasi 3 produk per halaman
  const rpp = 3; 
  const totalPages = Math.ceil(totalItems / rpp) || 1;

  // Proteksi halaman agar tidak error saat produk dihapus
  if (typeof currentSelectedPage === 'undefined') window.currentSelectedPage = 1;
  if (window.currentSelectedPage > totalPages) window.currentSelectedPage = totalPages;
  if (window.currentSelectedPage < 1) window.currentSelectedPage = 1;

  const startIndex = (window.currentSelectedPage - 1) * rpp;
  const endIndex = Math.min(startIndex + rpp, totalItems);
  const pageItems = allSelected.slice(startIndex, endIndex);

  let tableHTML = `
    <div class="fs-selected-wrapper">
      <table class="premium-table" style="width: 100%; min-width: 700px; font-size: 13px;">
        <thead>
          <tr>
            <th style="width: 34%; text-align: left; padding-left: 20px;">Nama Produk</th>
            <th style="width: 19%; text-align: center;">Harga Jual</th>
            <th style="width: 22%; text-align: center;">Potongan</th>
            <th style="width: 19%; text-align: center;">Harga Diskon</th>
            <th style="width: 8%; text-align: center;">Aksi</th>
          </tr>
        </thead>
        <tbody>
  `;

  // Render Baris Produk
  pageItems.forEach(id => {
    const prod = REAL_PRODUCTS.find(p => String(p.id) === String(id)) || { name: 'Produk tidak ditemukan', price: '0', stock: 0, variasi: '' };
    const basePrice = cleanRupiah(prod.price);
    
    if (typeof window.flashSaleDiscounts === 'undefined') window.flashSaleDiscounts = {};
    const savedDiscount = window.flashSaleDiscounts[id] || 0;
    
    let finalPriceHTML = '';
    if (!window.flashSaleDiscounts[id] || savedDiscount === 0) {
      finalPriceHTML = `<span class="badge b-neu">Belum Diatur</span>`;
    } else if (savedDiscount > basePrice) {
      finalPriceHTML = `<span class="num num-n" style="font-size: 13px;">Rp 0</span>`;
    } else {
      finalPriceHTML = `<span class="num num-h" style="font-size: 13px;">${toRupiah(basePrice - savedDiscount)}</span>`;
    }

    const variasiHTML = (prod.variasi && prod.variasi !== '—') ? `<br><span style="color:var(--c); font-size:10px;">Varian: ${prod.variasi}</span>` : '';

    tableHTML += `
      <tr>
        <td data-label="Nama Produk" style="white-space: normal; line-height: 1.4;">
          <div style="font-weight: 700; color: var(--t1); font-size: 12.5px;">${prod.name}</div>
          ${variasiHTML}
          <div style="font-size: 9.5px; color: var(--t3); font-family: var(--mono); margin-top: 5px;">ID: ${id}</div>
        </td>
        <td data-label="Harga Jual" class="num" data-base="${basePrice}" style="font-size: 12px; color: var(--t2);">
