/* Tabel Offline Dinamis (Paginasi, Baris Total Per Halaman & Tahun Otomatis) */
function renderPaOffline(){
  S.pa.offPage = S.pa.offPage || 1; 
  const rpp = 31; // 31 baris transaksi + 1 baris total = 32 baris per halaman

  const data = S.pa.offline || [];
  const bln = $('pa-off-bulan')?.value;
  
  const thnDropdown = $('pa-off-tahun');
  if (thnDropdown && thnDropdown.options.length <= 1) {
    const tahunMulai = 2024; 
    const tahunSekarang = new Date().getFullYear(); 
    for (let y = tahunMulai; y <= tahunSekarang; y++) {
      const opt = document.createElement('option');
      opt.value = y; opt.textContent = y;
      thnDropdown.appendChild(opt);
    }
  }
  const thn = thnDropdown?.value;

  // IDENTIFIKASI HEADER DINAMIS DARI GOOGLE SHEET
  let validHeaders = S.pa.offHeaders || (data.length > 0 ? Object.keys(data[0]) : []);
  let colsAdmin = [];
  let colTanggal = 'Tanggal';

  validHeaders.forEach(h => {
    let hl = h.toLowerCase().trim();
    if (hl === 'tanggal' || hl === 'date') { colTanggal = h; }
    else if (hl !== 'total' && hl !== '') { colsAdmin.push(h); }
  });

  // UBAH HEADER TABEL HTML OTOMATIS
  const thead = document.querySelector('#page-pa-offline table thead');
  if (thead) {
    let theadHTML = `<tr><th>${esc(colTanggal)}</th>`;
    colsAdmin.forEach(adm => { theadHTML += `<th>${esc(adm)}</th>`; });
    theadHTML += `<th>Total</th></tr>`;
    thead.innerHTML = theadHTML;
  }

  const parseNum = (v) => {
    if (v === undefined || v === null || v === '-' || v === '') return 0;
    return parseInt(String(v).replace(/[^\d]/g, '')) || 0;
  };

  // Filter Data
  let filtered = data.filter(r => {
    const rawTgl = r[colTanggal] || r['tanggal'];
    if (!rawTgl) return false;
    const dt = parseTgl(rawTgl);
    if (!dt || isNaN(dt.getTime())) return false; 
    const matchBln = !bln || (dt.getMonth() + 1).toString() === bln;
    const matchThn = !thn || dt.getFullYear().toString() === thn;
    return matchBln && matchThn;
  });

  // Hitung Grand Total Ringkasan Atas
  let totalSemuaAdmin = {};
  colsAdmin.forEach(adm => totalSemuaAdmin[adm] = 0);
  let grandTotalAll = 0;

  filtered.forEach(r => {
    let rowTotal = 0;
    colsAdmin.forEach(adm => {
      let val = parseNum(r[adm]);
      totalSemuaAdmin[adm] += val;
      rowTotal += val;
    });
    grandTotalAll += rowTotal;
  });

  const summaryEl = $('pa-off-summary');
  if (summaryEl) {
    let metaHtml = '';
    const colors = ['var(--c)', 'var(--p)', 'var(--g)', 'var(--y)', 'var(--r)'];
    colsAdmin.forEach((adm, i) => {
      metaHtml += `<span style="color:${colors[i % colors.length]}">${esc(adm)}: <b>${fmt(totalSemuaAdmin[adm])}</b></span> `;
    });

    summaryEl.innerHTML = `
      <div class="card tgt-card"><div class="tgt-lbl">Total Penjualan Offline</div>
        <div class="tgt-row"><span class="tgt-val">${fmt(grandTotalAll)}</span><span class="tgt-pct">Unit</span></div>
        <div class="tgt-meta" style="justify-content: flex-start; gap: 15px; flex-wrap: wrap;">
          ${metaHtml}
        </div>
      </div>`;
  }

  const totalData = filtered.length;
  const totalPg = Math.max(1, Math.ceil(totalData / rpp));
  if (S.pa.offPage > totalPg) S.pa.offPage = totalPg;

  const startIndex = (S.pa.offPage - 1) * rpp;
  const slice = filtered.slice(startIndex, startIndex + rpp);

  // Hitung Total Khusus Halaman Ini Saja
  let pageSemuaAdmin = {};
  colsAdmin.forEach(adm => pageSemuaAdmin[adm] = 0);
  let pageAll = 0;

  slice.forEach(r => {
    let rowTotal = 0;
    colsAdmin.forEach(adm => {
      let val = parseNum(r[adm]);
      pageSemuaAdmin[adm] += val;
      rowTotal += val;
    });
    pageAll += rowTotal;
  });

  const tb = $('pa-off-tbody');
  if (!tb) return;

  if (!slice.length) {
    tb.innerHTML = `<tr><td colspan="${colsAdmin.length + 2}"><div class="empty"><div class="ei">📭</div><p>Tidak ada data penjualan di periode ini</p></div></td></tr>`;
  } else {
    let htmlRows = slice.map(r => {
      let rawTgl = r[colTanggal] || r['tanggal'];
      let rowTotal = 0;
      let trHTML = `<tr><td data-label="Tanggal" style="font-weight:600; color:var(--t1)">${esc(formatTanggalTampilan(rawTgl))}</td>`;
      
      colsAdmin.forEach(adm => {
        let val = parseNum(r[adm]);
        rowTotal += val;
        trHTML += `<td data-label="${esc(adm)}" class="num">${fmt(val)}</td>`;
      });
      
      trHTML += `<td data-label="Total" class="num num-h">${fmt(rowTotal)}</td></tr>`;
      return trHTML;
    }).join('');

    // Baris Total Halaman Ini
    let totalRowHTML = `
      <tr class="total-row">
        <td data-label="Keterangan" style="font-weight:800; color:var(--t1); text-transform:uppercase; letter-spacing:1px; text-align:left;">Total Keseluruhan:</td>`;
    
    const colors = ['var(--c)', 'var(--p)', 'var(--g)', 'var(--y)', 'var(--r)'];
    colsAdmin.forEach((adm, i) => {
      totalRowHTML += `<td data-label="Total ${esc(adm)}" class="num" style="color:${colors[i % colors.length]}; font-weight:800;">${fmt(pageSemuaAdmin[adm])}</td>`;
    });
    totalRowHTML += `<td data-label="Grand Total" class="num num-h" style="font-size:14.5px; font-weight:800;">${fmt(pageAll)}</td></tr>`;

    tb.innerHTML = htmlRows + totalRowHTML;
  }

  const pinfo = $('pa-off-pinfo');
  const pbtns = $('pa-off-pbtns');
  if (pinfo) pinfo.textContent = `${totalData} transaksi · Hal ${S.pa.offPage}/${totalPg}`;
  if (pbtns) renderPag('pa-off-pbtns', S.pa.offPage, totalPg, p => { S.pa.offPage = p; renderPaOffline(); });
}

