    if (footerContainer) footerContainer.innerHTML = `<span>Periode: ${getNamaPeriodeTxt(bln, thn)}</span>`;
    return;
  }

  const top1 = dataList[0];
  let top1Pct = top1.targetDetik > 0 ? Math.round((top1.capaiDetik / top1.targetDetik) * 100) : 0;
  let top1JamTxt = secondsToHourLabel(top1.capaiDetik);
  
  // --- LOGIKA DETEKSI BULAN BERJALAN ATAU SUDAH LEWAT ---
  let now = new Date();
  let currentMonth = now.getMonth() + 1;
  let currentYear = now.getFullYear();
  
  // Default pakai periode sekarang jika filter kosong
  let fThn = thn ? parseInt(thn, 10) : currentYear;
  let fBln = bln ? parseInt(bln, 10) : currentMonth;
  
  let badgePeringkatText = "⭐ Peringkat #1. Sementara Bulan Ini"; // Default jika bulan belum habis
  if (fThn < currentYear || (fThn === currentYear && fBln < currentMonth)) {
      badgePeringkatText = "⭐ Peringkat #1. Performa Terbaik Di Bulan Ini"; // Jika sudah ganti bulan
  }
  // -----------------------------------------------------

  if (heroContainer) {
    heroContainer.innerHTML = `
      <div class="lb-hero-card">
        <div class="lb-hero-main">
          <div class="lb-avatar-wrapper">
            ${top1.capaiDetik > 0 ? '<span class="lb-badge-rank1">🥇</span>' : ''}
            <img src="${top1.img}" alt="${esc(top1.host)}" class="lb-avatar-lg" onerror="this.src='https://ui-avatars.com/api/?name=${encodeURIComponent(top1.host)}&background=random'">
          </div>
          <div class="lb-hero-info">
            <h3 class="lb-hero-name">${esc(top1.host)}</h3>
            <div class="lb-hero-metric">
              <span class="lb-metric-value">${top1JamTxt}</span>
              <span class="lb-metric-badge">${top1Pct}% <small>dari target</small></span>
            </div>
            <div style="font-size:11px; color:#64748b; margin-top:4px;">Update: ${top1.tglUpdateTerakhir}</div>
          </div>
        </div>
        <div class="lb-hero-badges">
          <span class="lb-tag ${top1Pct >= 100 ? 'lb-tag-success' : 'lb-tag-warning'}">
            ${top1Pct >= 100 ? '✓ Target Tercapai' : (top1.capaiDetik === 0 ? 'Belum Ada Jam Tayang' : '🏃 Mendekati Target')}
          </span>
          <span class="lb-tag lb-tag-warning">${top1.capaiDetik > 0 ? badgePeringkatText : 'Menunggu Input'}</span>
        </div>
      </div>
    `;
  }

  let rowsHtml = '';
  dataList.forEach((item, index) => {
    let pct = item.targetDetik > 0 ? Math.round((item.capaiDetik / item.targetDetik) * 100) : 0;
    
    let rankDisplay = '<span style="color:var(--t3); font-weight:bold;">—</span>';
    if (item.capaiDetik > 0) {
      let rank = index + 1;
      rankDisplay = rank === 1 ? '<span class="rank-medal">🥇</span>' : 
                    rank === 2 ? '<span class="rank-medal">🥈</span>' : 
                    rank === 3 ? '<span class="rank-medal">🥉</span>' : 
                    `<span class="rank-badge gray">${rank}</span>`;
    }
    
    let statusClass = 'b-neu';
    let statusLabel = 'Belum Mulai';
    if (pct >= 100) { statusClass = 'b-ach'; statusLabel = 'Tercapai'; }
    else if (pct >= 80) { statusClass = 'b-pro'; statusLabel = 'Hampir'; }
    else if (item.capaiDetik > 0) { statusClass = 'b-pro'; statusLabel = 'Proses'; }

    rowsHtml += `
      <tr>
        <td style="text-align: center;">${rankDisplay}</td>
        <td>
          <div class="lb-user-cell" style="display:flex; align-items:center; gap:10px;">
            <img src="${item.img}" class="lb-user-avatar" style="width:34px; height:34px; border-radius:50%; object-fit:cover;" alt="${esc(item.host)}" onerror="this.src='https://ui-avatars.com/api/?name=${encodeURIComponent(item.host)}&background=random'">
            <div style="display:flex; flex-direction:column;">
               <span class="lb-user-name" style="font-weight:600; color:var(--t1);">${esc(item.host)}</span>
               <span style="font-size:10px; color:#94a3b8; font-weight:normal;">Update: ${item.tglUpdateTerakhir}</span>
            </div>
          </div>
        </td>
        <td>${secondsToHourLabel(item.targetDetik)}</td>
        <td style="font-weight:bold; color:var(--c);">${secondsToHourLabel(item.capaiDetik)}</td>
        <td><b>${pct}%</b></td>
        <td><span class="badge ${statusClass}">${statusLabel}</span></td>
      </tr>
    `;
  });

  if (tbodyContainer) tbodyContainer.innerHTML = rowsHtml;
  if (footerContainer) footerContainer.innerHTML = `<span>Periode: ${getNamaPeriodeTxt(bln, thn)}</span>`;
}

function getNamaPeriodeTxt(bln, thn) {
  const namaBulan = ["", "Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"];
  let teksBln = bln ? namaBulan[parseInt(bln, 10)] : "Semua Bulan";
  let teksThn = thn || new Date().getFullYear();
  return `${teksBln} ${teksThn}`;
}


// ==========================================================
// 5. PROSES DATA TOP PERFORMA CHAT (LOGIKA: DATA TERAKHIR)
// ==========================================================
function prosesDataChat(bln, thn) {
  const rawSettings = typeof S !== 'undefined' ? (S.setting || S.pa?.setting || []) : [];
  const rawChatLogs = typeof S !== 'undefined' ? (S.chat || S.pa?.chat || S.pa?.responChat || []) : [];

  // 1. Filter Log Sesuai Bulan/Tahun & URUTKAN DARI TERBARU (Descending)
  const filteredLogs = rawChatLogs.filter(row => {
    let tgl = parseTglAkurat(row.Tanggal || row.tanggal || row.Date || '');
    if (!tgl || isNaN(tgl.getTime()) || tgl.getTime() === 0) return false;
    
    let itemBln = (tgl.getMonth() + 1).toString();
    let itemThn = tgl.getFullYear().toString();
    
    let matchBln = bln === "" || parseInt(itemBln, 10) === parseInt(bln, 10);
    let matchThn = thn === "" || itemThn === thn;
    
    return matchBln && matchThn;
  }).sort((a, b) => {
    let tglA = parseTglAkurat(a.Tanggal || a.tanggal || a.Date || '');
    let tglB = parseTglAkurat(b.Tanggal || b.tanggal || b.Date || '');
    return tglB.getTime() - tglA.getTime(); // Data paling baru / tanggal terbesar di atas
  });

  let masterAdmin = [];
  let currentCategory = "";
  let currentAdmin = "";

  rawSettings.forEach(r => {
    let kat = (r['Kategori'] || '').toString().trim();
    if (kat) currentCategory = kat.toLowerCase();
    
    let adminVal = (r['Admin'] || r['Host'] || r['Nama'] || '').toString().trim();
    if (adminVal) currentAdmin = adminVal;

    if (currentCategory.includes('chat') || currentCategory.includes('admin')) {
      let onlineChannel = (r['Online'] || r['Channel'] || currentAdmin).toString().trim();
      let targetStr = (r.Chat || r.Target || '0').toString().replace('%', '').trim();
      let targetChat = parseFloat(targetStr) || 0;
      let imgFoto = r.Gambar || r.Foto || r.Image || `https://ui-avatars.com/api/?name=${encodeURIComponent(currentAdmin)}&background=random`;

      if (currentAdmin) {
        masterAdmin.push({
          admin: currentAdmin,
          channel: onlineChannel,
          targetChat: targetChat,
          performaTerakhir: 0, // Menggantikan variabel rata-rata
          tglUpdateTerakhir: '-',
          img: imgFoto
        });
      }
    }
  });

  // 2. Loop per admin, temukan data valid PERTAMA (karena sudah disortir dari yang terbaru)
  masterAdmin.forEach(m => {
    let keyChannel = m.channel.toLowerCase().trim();
    let ditemukan = false;
    
    for (let i = 0; i < filteredLogs.length; i++) {
      let row = filteredLogs[i];
      for (let key in row) {
        let header = key.toLowerCase().trim();
        if (header === 'tanggal' || header === 'no' || header === 'status') continue;

        // Wajib pakai === (Sama persis) agar Shopee 1 tidak bentrok dengan Shopee 14
        if (header === keyChannel) {
          let valOri = row[key].toString().trim();
          
          // Lompati baris yang kosong atau isinya cuma strip "-" (mirip dengan logika script Anda)
          if (valOri !== '' && valOri !== '-' && /\d/.test(valOri)) {
              let valNum = parseFloat(valOri.replace('%', '').replace(',', '.'));
              if (!isNaN(valNum)) {
                  m.performaTerakhir = valNum;
                  
                  // Simpan keterangan kapan data ini diambil (untuk visual)
                  let rawTgl = row.Tanggal || row.tanggal || row.Date;
                  m.tglUpdateTerakhir = parseTglAkurat(rawTgl).toLocaleDateString('id-ID', {day:'2-digit', month:'2-digit', year:'numeric'});
                  
                  ditemukan = true;
                  break; // HENTIKAN PENCARIAN KOLOM UNTUK BARIS INI
              }
          }
        }
      }
      // HENTIKAN LOOP BARIS UNTUK ADMIN INI JIKA SUDAH KETEMU DATA TERBARU
      if (ditemukan) break; 
    }
  });

  // 3. Sorting Rank Berdasarkan Performa Terakhir
  masterAdmin.sort((a, b) => b.performaTerakhir - a.performaTerakhir);

  cetakTopChatKeHtml(masterAdmin.slice(0, 10), bln, thn);
}

// ==========================================================
// 6. RENDERING DISPLAY CHAT ADMIN (DENGAN STATUS BULAN)
// ==========================================================
function cetakTopChatKeHtml(dataList, bln, thn) {
  const heroContainer = document.getElementById('hero-chat');
  const tbodyContainer = document.getElementById('tbody-chat');
  const footerContainer = document.getElementById('footer-chat');

  if (!dataList || dataList.length === 0) {
    if (heroContainer) heroContainer.innerHTML = '';
    if (tbodyContainer) tbodyContainer.innerHTML = `<tr><td colspan="6" style="text-align:center; padding: 24px; color: #64748b;">Belum ada Data Admin / Filter Kosong.</td></tr>`;
    if (footerContainer) footerContainer.innerHTML = `<span>Periode: ${getNamaPeriode(bln, thn)}</span>`;
    return;
  }

  const top1 = dataList[0];
  let top1Pct = top1.targetChat > 0 ? Math.round((top1.performaTerakhir / top1.targetChat) * 100) : 0;

  // --- LOGIKA DETEKSI WAKTU & STATUS BULAN (Sama Seperti Live Host) ---
  let now = new Date();
  let currentMonth = now.getMonth() + 1; 
  let currentYear = now.getFullYear();

  let fThn = thn ? parseInt(thn, 10) : currentYear;
  let fBln = bln ? parseInt(bln, 10) : currentMonth;

  let isFuture = false;
  if (fThn > currentYear || (fThn === currentYear && fBln > currentMonth)) {
      isFuture = true;
  }

  let badgePeringkatText = "⭐ Peringkat #1. Sementara Bulan Ini";
  if (fThn < currentYear || (fThn === currentYear && fBln < currentMonth)) {
      badgePeringkatText = "⭐ Peringkat #1. Performa Terbaik Di Bulan Ini";
  }
  // -------------------------------------------------------------------

  // Hero Card (Top 1)
  if (heroContainer) {
    let heroTagClass = 'lb-tag-warning';
    let heroTagText = '🏃 Mendekati Target';
    
    if (top1.performaTerakhir >= top1.targetChat) {
       heroTagClass = 'lb-tag-success';
       heroTagText = '✓ Target Tercapai';
    } else if (top1.performaTerakhir === 0) {
       heroTagText = isFuture ? 'Menunggu Aktivitas' : 'Minus';
    }

    heroContainer.innerHTML = `
      <div class="lb-hero-card">
        <div class="lb-hero-main">
          <div class="lb-avatar-wrapper">
            <span class="lb-badge-rank1">🥇</span>
            <img src="${top1.img}" alt="${top1.admin}" class="lb-avatar-lg" onerror="this.src='https://ui-avatars.com/api/?name=${encodeURIComponent(top1.admin)}&background=random'">
          </div>
          <div class="lb-hero-info">
            <h3 class="lb-hero-name">${top1.admin} - ${top1.channel}</h3>
            <div class="lb-hero-metric">
              <span class="lb-metric-value">${top1.performaTerakhir.toFixed(2)}%</span>
              <span class="lb-metric-badge">${top1Pct}% <small>dari target</small></span>
            </div>
            <div style="font-size:11px; color:#64748b; margin-top:4px;">Update: ${top1.tglUpdateTerakhir}</div>
          </div>
        </div>
        <div class="lb-hero-badges">
          <span class="lb-tag ${heroTagClass}">${heroTagText}</span>
          <span class="lb-tag lb-tag-warning">${badgePeringkatText}</span>
        </div>
      </div>
    `;
  }

  // Render Tabel List Leaderboard
  let rowsHtml = '';
  dataList.forEach((item, index) => {
    let rank = index + 1;
    let rankDisplay = rank === 1 ? '<span class="rank-medal">🥇</span>' : 
                      rank === 2 ? '<span class="rank-medal">🥈</span>' : 
                      rank === 3 ? '<span class="rank-medal">🥉</span>' : 
                      `<span class="rank-badge gray">${rank}</span>`;
    
    let performa = item.performaTerakhir;
    let statusClass = '';
    let statusLabel = '';

    // ==========================================
    // LOGIKA STATUS (Tercapai, Hampir, Evaluasi)
    // ==========================================
    if (performa >= item.targetChat) { 
        statusClass = 'tercapai'; 
        statusLabel = 'Tercapai'; 
    } else if (performa >= 90) { 
        statusClass = 'hampir'; 
        statusLabel = 'Hampir'; 
    } else if (performa > 0) { 
        statusClass = 'evaluasi'; 
        statusLabel = 'Evaluasi'; 
    } else { 
        if (isFuture) {
            statusClass = 'belum'; 
            statusLabel = 'Belum Mulai'; 
        } else {
            statusClass = 'minus'; 
            statusLabel = 'Minus'; 
        }
    }

    rowsHtml += `
      <tr>
        <td>${rankDisplay}</td>
        <td>
          <div class="lb-user-cell">
            <img src="${item.img}" class="lb-user-avatar" alt="${item.admin}" onerror="this.src='https://ui-avatars.com/api/?name=${encodeURIComponent(item.admin)}&background=random'">
            <div style="display:flex; flex-direction:column;">
               <span class="lb-user-name">${item.admin}</span>
               <span style="font-size:10px; color:#94a3b8; font-weight:normal;">Update: ${item.tglUpdateTerakhir}</span>
            </div>
          </div>
        </td>
        <td style="color: #64748b;">${item.channel}</td>
        <td>${item.targetChat}%</td>
        <td style="font-weight:bold; color: #0f172a;">${performa.toFixed(2)}%</td>
        <td><span class="status-pill ${statusClass}">${statusLabel}</span></td>
      </tr>
    `;
  });

  if (tbodyContainer) tbodyContainer.innerHTML = rowsHtml;
  if (footerContainer) footerContainer.innerHTML = `<span>Periode: ${getNamaPeriode(bln, thn)}</span>`;
}

function getNamaPeriode(bln, thn) {
  const namaBulan = ["", "Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"];
  let teksBln = bln ? namaBulan[parseInt(bln, 10)] : "Semua Bulan";
  let teksThn = thn ? thn : "Semua Tahun";
  return `${teksBln} ${teksThn}`;
}

// ==========================================================
// FUNGSI RESET FILTER (ATUR ULANG)
// ==========================================================
function resetLbFilter() {
  const selectBulan = document.getElementById('pa-lb-bulan');
  const selectTahun = document.getElementById('pa-lb-tahun');

  const now = new Date();
  let blnAngka = (now.getMonth() + 1).toString();
  const thnAngka = now.getFullYear().toString();

  if (selectBulan && selectBulan.querySelector('option[value="01"]')) {
    blnAngka = blnAngka.padStart(2, '0');
  }

  if (selectBulan) selectBulan.value = blnAngka;
  if (selectTahun) selectTahun.value = thnAngka;

  renderPaLbLive(blnAngka, thnAngka);
  prosesDataChat(blnAngka, thnAngka);
}

