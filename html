// =========================================================================

// Helper: Ubah persentase string
function parsePercentChat(val) {
  if (!val) return 0;
  let str = val.toString().trim().replace('%', '');
  str = str.replace(',', '.'); 
  let num = parseFloat(str);
  return isNaN(num) ? 0 : num;
}

// Helper: Deteksi format tanggal Sheet 
function parseSheetDateChat(dateStr) {
  if (!dateStr) return new Date(0);
  let str = dateStr.toString().split(' ')[0]; 
  if (str.includes('/')) {
      const p = str.split('/');
      if (p[2] && p[2].length === 4) return new Date(p[2], p[1] - 1, p[0]); 
      if (p[0] && p[0].length === 4) return new Date(p[0], p[1] - 1, p[2]); 
  }
  return new Date(dateStr);
}

function renderPaTabelChat(bulan, tahun) {
  const targetBulan = parseInt(bulan);
  const targetTahun = parseInt(tahun);

  // 1. AMBIL, FILTER (BUANG BARIS KOSONG), & URUTKAN DATA
  const sourceData = S.pa.chat || S.pa.responChat || [];
  
  // LOGIKA BARU: Filter baris yang nilainya cuma tanda strip (-)
  const validData = sourceData.filter(row => {
      return Object.keys(row).some(key => {
          let k = key.toLowerCase();
          // Kita lewati pengecekan untuk kolom tanggal
          if (k.includes('tanggal') || k.includes('date') || k.includes('waktu')) return false;
          
          let val = row[key].toString().trim();
          // Baris dianggap valid kalau minimal ada 1 kolom yg berisi angka
          return val !== '-' && val !== '' && /\d/.test(val); 
      });
  });

  // Urutkan data yang sudah disaring dari terbaru ke terlama
  const sortedData = validData.sort((a, b) => {
      const dA = parseSheetDateChat(a['Tanggal'] || a['TANGGAL'] || a['Date']);
      const dB = parseSheetDateChat(b['Tanggal'] || b['TANGGAL'] || b['Date']);
      return dB.getTime() - dA.getTime();
  });

  // 2. CARI INDEX MINGGU INI & MINGGU LALU
  let idxMingguIni = -1;
  for (let i = 0; i < sortedData.length; i++) {
      const d = parseSheetDateChat(sortedData[i]['Tanggal'] || sortedData[i]['TANGGAL'] || sortedData[i]['Date']);
      if (d.getMonth() + 1 === targetBulan && d.getFullYear() === targetTahun) {
          idxMingguIni = i;
          break; 
      }
  }

  let rowMingguIni = idxMingguIni !== -1 ? sortedData[idxMingguIni] : null;
  let rowMingguLalu = (idxMingguIni !== -1 && idxMingguIni + 1 < sortedData.length) ? sortedData[idxMingguIni + 1] : null;

  // -- UPDATE TANGGAL "DATA TERAKHIR" DI HTML --
  const elLastUpdate = document.getElementById('pa-dash-chat-last-update');
  if (elLastUpdate) {
      if (rowMingguIni) {
          let rawTgl = rowMingguIni['Tanggal'] || rowMingguIni['TANGGAL'] || rowMingguIni['Date'];
          let d = parseSheetDateChat(rawTgl);
          elLastUpdate.innerText = d.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' });
      } else {
          elLastUpdate.innerText = "-";
      }
  }

  // 3. AMBIL MASTER SETTING
  const rawSettings = S.setting || S.pa.setting || [];
  const chatMaster = [];
  let currentKategori = "";
  let currentAdmin = "";

  rawSettings.forEach(r => {
      let kat = (r['Kategori'] || '').toString().trim();
      if (kat) currentKategori = kat;
      let admin = (r['Admin'] || '').toString().trim();
      if (admin) currentAdmin = admin; 

      if (currentKategori.toLowerCase().includes('chat')) {
          let online = (r['Online'] || r['Channel'] || '').toString().trim();
          let targetVal = r['Chat'] || r['Target'] || '0';
          if (online) {
              chatMaster.push({
                  admin: currentAdmin,
                  online: online,
                  target: parsePercentChat(targetVal)
              });
          }
      }
  });

  // 4. KALKULASI & RENDER BARIS HTML (6 KOLOM)
  let html = "";

  chatMaster.forEach(m => {
      let valIni = 0;
      let valLalu = 0;
      const channelKey = m.online.toLowerCase().trim();

      if (rowMingguIni) {
          const matchedCol = Object.keys(rowMingguIni).find(k => k.toLowerCase().trim() === channelKey);
          if (matchedCol) valIni = parsePercentChat(rowMingguIni[matchedCol]);
      }
      if (rowMingguLalu) {
          const matchedCol = Object.keys(rowMingguLalu).find(k => k.toLowerCase().trim() === channelKey);
          if (matchedCol) valLalu = parsePercentChat(rowMingguLalu[matchedCol]);
      }

      // Indikator Trend (Bandingkan dengan minggu lalu)
      const isNaik = valIni >= valLalu;
      const warnaTrend = isNaik ? '#10b981' : '#ef4444'; 
      const iconTrend = valLalu > 0 ? (isNaik ? '▲' : '▼') : '';

      // Indikator Status (Bandingkan dengan Target Setting)
      const isAchieved = valIni >= m.target;
      const statusText = isAchieved ? 'Tercapai' : 'Kurang';
      const statusBg = isAchieved ? '#d1fae5' : '#fee2e2';
      const statusWarna = isAchieved ? '#059669' : '#dc2626';

      const displayTarget = m.target > 0 ? m.target.toFixed(2) + '%' : '0%';
      const displayLalu = valLalu > 0 ? valLalu.toFixed(2) + '%' : '0%';
      const displayIni = valIni > 0 ? valIni.toFixed(2) + '%' : '0%';

      html += `
        <tr style="border-bottom: 1px solid #f1f5f9;">
          <td style="font-weight: 600; color: #334155;">${m.admin}</td>
          <td style="color: #475569;">${m.online}</td>
          <td style="color: #64748b; font-weight: 500;">${displayTarget}</td>
          <td style="font-weight: 500;">${displayLalu}</td>
          <td style="font-weight: bold; color: ${valIni > 0 ? warnaTrend : 'inherit'};">
            ${displayIni} <span style="font-size: 9px; margin-left: 2px;">${iconTrend}</span>
          </td>
          <td style="text-align: center;">
            <span style="font-size: 11px; font-weight: 600; color: ${statusWarna}; background: ${statusBg}; padding: 4px 8px; border-radius: 4px;">
              ${statusText}
            </span>
          </td>
        </tr>
      `;
  });

  // 5. INJECT KE HTML
  const el = document.getElementById('pa-dash-tbl-chat');
  if (el) {
      el.innerHTML = html || '<tr><td colspan="6" style="text-align:center; padding: 20px; color: #6c757d;">Tidak ada data Performa Chat di Setting.</td></tr>';
  }
}

