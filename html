  function generateTableRowHTML(toko, target, terjual, isTotal = false, bulan, tahun) {
  const styleTr = isTotal ? 'style="font-weight: bold; background-color: #f8fafc; color: #0f172a;"' : '';

  // 1. KONDISI KHUSUS: Toko Non-Aktif
  if (target === 0 && terjual === 0) {
    return `
      <tr ${styleTr}>
        <td>${toko}</td>
        <td>0</td>
        <td>0</td>
        <td>0</td>
        <td style="text-align: center;">-</td>
        <td><span class="badge missed-target">Non-Aktif</span></td>
      </tr>
    `;
  }

  // 2. KONDISI NORMAL: Kalkulasi Target & Terjual
  let sisaText = "Sama";
  if (terjual > target) sisaText = "+" + fmt(terjual - target);
  else if (terjual < target) sisaText = "-" + fmt(target - terjual);

  let pct = 0;
  if (target > 0) {
    pct = Math.round((terjual / target) * 100);
  } else if (terjual > 0 && target === 0) {
    pct = 100;
  }

  // --- DESAIN PROGRESS BAR PERSENTASE (UKURAN SEDANG) ---
  // Kita batasi lebar maksimal container agar tidak memenuhi kolom (max-width: 80px)
  let barWidth = pct > 100 ? 100 : pct; 
  let barColor = pct >= 100 ? '#10b981' : (pct >= 50 ? '#f59e0b' : '#ef4444');

  let pctHTML = `
    <div style="display: flex; align-items: center; gap: 8px;">
      <div style="width: 80px; background-color: #e2e8f0; border-radius: 99px; height: 7px; overflow: hidden;">
        <div style="width: ${barWidth}%; height: 100%; background-color: ${barColor}; border-radius: 99px;"></div>
      </div>
      <span style="font-size: 11px; font-weight: 600; color: #475569;">${pct}%</span>
    </div>
  `;

  // 3. LOGIKA STATUS (Tetap sama seperti sebelumnya)
  let statusText = "";
  let badgeClass = "";

  const sekarang = new Date();
  const bulanSekarang = sekarang.getMonth() + 1;
  const tahunSekarang = sekarang.getFullYear();
  const isBulanBerjalan = (parseInt(bulan) === bulanSekarang) && (parseInt(tahun) === tahunSekarang); 

  if (terjual >= target) {
    statusText = "Achieved +";
    badgeClass = "achieved";
  } else if (isBulanBerjalan) {
    statusText = "Under Process";
    badgeClass = "under-process";
  } else {
    statusText = "Missed Target";
    badgeClass = "missed-target";
  }

  // 4. RENDER BARIS TABEL
  return `
    <tr ${styleTr}>
      <td>${toko}</td>
      <td>${fmt(target)}</td>
      <td>${fmt(terjual)}</td>
      <td>${sisaText}</td>
      <td>${pctHTML}</td>
      <td><span class="badge ${badgeClass}">${statusText}</span></td>
    </tr>
  `;
}

