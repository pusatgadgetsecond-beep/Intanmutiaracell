  prosesDataChat(blnAngka, thnAngka);
}

function applyLbFilter() {
  const bln = document.getElementById('pa-lb-bulan')?.value || '';
  const thn = document.getElementById('pa-lb-tahun')?.value || '';
  renderPaLbLive(bln, thn);
  prosesDataChat(bln, thn);
}

// ==========================================================
// 3. PROSES UTAMA KLASEMEN TOP LIVE HOST (SUDAH DIUBAH)
// ==========================================================
function timeToSeconds(val) {
  if (!val || val === '-' || val.toString().toLowerCase() === 'libur') return 0;
  let str = val.toString().trim().toLowerCase().replace('jam', '').trim();
  
  if (!str.includes(':') && !isNaN(parseFloat(str))) {
    return Math.round(parseFloat(str) * 3600);
  }
  
  if (str.includes(':')) {
    let parts = str.split(':').map(Number);
    if (parts.length === 3) return (parts[0] * 3600) + (parts[1] * 60) + (parts[2] || 0);
    if (parts.length === 2) return (parts[0] * 3600) + (parts[1] * 60);
  }
  
  let num = parseFloat(str);
  return isNaN(num) ? 0 : Math.round(num * 3600);
}

function secondsToHourLabel(detik) {
  if (!detik || detik <= 0) return "0 Jam";
  let jam = Math.floor(detik / 3600);
  let sisaMenit = Math.floor((detik % 3600) / 60);
  return sisaMenit > 0 ? `${jam} Jam ${sisaMenit}m` : `${jam} Jam`;
}

function renderPaLbLive(bulanFilter = null, tahunFilter = null) {
  const now = new Date();
  const targetBulan = bulanFilter !== null ? bulanFilter : (now.getMonth() + 1).toString();
  const targetTahun = tahunFilter !== null ? tahunFilter : now.getFullYear().toString();

  const rawSettings = typeof S !== 'undefined' ? (S.setting || S.pa?.setting || []) : [];
  const rawLiveLogs = typeof S !== 'undefined' ? (S.live || S.pa?.live || []) : [];

  // Ditambahkan urutkan dari terbaru (Sorting Descending) mirip chat
  const filteredLogs = rawLiveLogs.filter(row => {
    let dt = parseTglAkurat(row.Tanggal || row.tanggal || row.Date || '');
    if (!dt || isNaN(dt.getTime()) || dt.getTime() === 0) return false;
    
    let itemBln = (dt.getMonth() + 1).toString();
    let itemThn = dt.getFullYear().toString();
    
    let matchBln = targetBulan === "" || parseInt(itemBln, 10) === parseInt(targetBulan, 10);
    let matchThn = targetTahun === "" || itemThn === targetTahun;
    
    return matchBln && matchThn;
  }).sort((a, b) => {
    let tglA = parseTglAkurat(a.Tanggal || a.tanggal || a.Date || '');
    let tglB = parseTglAkurat(b.Tanggal || b.tanggal || b.Date || '');
    return tglB.getTime() - tglA.getTime();
  });

  let masterHost = [];
  let currentCategory = "";

  rawSettings.forEach(r => {
    let kat = (r.Kategori || r.kategori || '').toString().trim().toLowerCase();
    if (kat) currentCategory = kat;
    
    if (currentCategory.includes('live') || currentCategory.includes('target jam')) {
      let hostName = (r.Host || r.Nama || r['Nama Host'] || '').toString().trim();
      let targetJamVal = (r.Target || r['Target Live'] || r.Jam || '0').toString(); 
      let targetDetik = timeToSeconds(targetJamVal);
      let imgFoto = r.Gambar || r.Foto || r.Image || r.Profil || 
                    `https://ui-avatars.com/api/?name=${encodeURIComponent(hostName)}&background=random`;

      if (hostName) {
        masterHost.push({ 
          host: hostName, 
          targetDetik: targetDetik, 
          capaiDetik: 0, 
          firstInputIndex: 999999, 
          img: imgFoto,
          tglUpdateTerakhir: '-' // Tambahkan data tgl terbaru
        });
      }
    }
  });

  masterHost.forEach((m, mIndex) => {
    let keyHost = m.host.toLowerCase().trim();
    let ketemuTglBaru = false;

    filteredLogs.forEach((row, logIndex) => {
      for (let key in row) {
        let header = key.toLowerCase().trim();
        if (header === 'tanggal' || header === 'no' || header === 'status') continue;

        if (header === keyHost) {
          let detikVal = timeToSeconds(row[key]);
          if (detikVal > 0) {
            m.capaiDetik += detikVal;
            if (logIndex < m.firstInputIndex) m.firstInputIndex = logIndex;

            // Capture tanggal terbaru pertama kali saja
            if (!ketemuTglBaru) {
                let rawTgl = row.Tanggal || row.tanggal || row.Date;
                m.tglUpdateTerakhir = parseTglAkurat(rawTgl).toLocaleDateString('id-ID', {day:'2-digit', month:'2-digit', year:'numeric'});
                ketemuTglBaru = true;
            }
          }
          break;
        }
      }
    });
  });

  masterHost.sort((a, b) => b.capaiDetik !== a.capaiDetik ? b.capaiDetik - a.capaiDetik : a.firstInputIndex - b.firstInputIndex);
  cetakTopLiveHostKeHtml(masterHost.slice(0, 10), targetBulan, targetTahun);
}

// ==========================================================
// 4. RENDERING DISPLAY LIVE HOST (DENGAN TANGGAL & STATUS BULAN)
// ==========================================================
