  const offlineMaster = [];
  const onlineMaster = [];

  rawSettings.forEach(r => {
    let kat = (r['Kategori'] || '').toString().trim();
    if (kat) currentKategori = kat; 

    let toko = (r['Toko'] || '').toString().trim();
    let targetVal = parseInt((r['Target'] || '0').toString().replace(/[^0-9]/g, '')) || 0;

    if (toko) {
      if (currentKategori.toLowerCase().includes('offline')) {
        offlineMaster.push({ toko, target: targetVal });
      } else if (currentKategori.toLowerCase().includes('online')) {
        onlineMaster.push({ toko, target: targetVal });
      }
    }
  });

  const baseOffline = (S.pa.offline || S.pa.penjualan || []).filter(r => paIsDateMatch(r, bulan, tahun));
  const baseOnline = (S.pa.online || S.pa.penjualan || []).filter(r => paIsDateMatch(r, bulan, tahun));

  // --- KAMUS MAPPING CHANNEL ONLINE ---
  const mapOnline = {
    'intan mutiara': ['shopee 1'],
    'mutiara flasher': [
      'shopee 4', 'shopee 6', 'shopee 9', 'shopee 12', 'shopee 13', 'shopee 14',
      'tokped 5', 'lazada 7', 'akulaku 1', 'akulaku 3'
    ],
    'tiga mutiara': []
  };

  // --- RENDERING OFFLINE ---
  let htmlOffline = "";
  let totTargetOff = 0;
  let totTerjualOff = 0;

  offlineMaster.forEach(m => {
    let terjual = 0;
    baseOffline.forEach(r => {
      const matchedColumn = Object.keys(r).find(key => key.trim().toLowerCase() === m.toko.toLowerCase());
      if (matchedColumn) {
          terjual += parseInt((r[matchedColumn] || '0').toString().replace(/[^0-9]/g, '')) || 0;
      } else if ((r['Toko'] || '').trim().toLowerCase() === m.toko.toLowerCase()) {
          terjual += parseInt((r['Terjual'] || '0').toString().replace(/[^0-9]/g, '')) || 0;
      }
    });

    totTargetOff += m.target;
    totTerjualOff += terjual;
    htmlOffline += generateTableRowHTML(m.toko, m.target, terjual, false, bulan, tahun);
  });

  if (offlineMaster.length > 0) htmlOffline += generateTableRowHTML("Total", totTargetOff, totTerjualOff, true, bulan, tahun);
  
  const elOff = $('pa-dash-tbl-offline');
  if (elOff) elOff.innerHTML = htmlOffline || '<tr><td colspan="6" style="text-align:center;">Tidak ada data Offline. Pastikan setting Kategori & Toko benar.</td></tr>';


  // --- RENDERING ONLINE (SUDAH MENGGUNAKAN MAPPING KELOMPOK CHANNEL) ---
  let htmlOnline = "";
  let totTargetOnl = 0;
  let totTerjualOnl = 0;

  onlineMaster.forEach(m => {
    let terjual = 0;
    const tokoKey = m.toko.trim().toLowerCase();

    baseOnline.forEach(r => {
      // Jika nama toko terdaftar di dalam kamus mapping online
      if (mapOnline[tokoKey]) {
        const channels = mapOnline[tokoKey];
        channels.forEach(ch => {
          const matchedColumn = Object.keys(r).find(key => key.trim().toLowerCase() === ch.toLowerCase());
          if (matchedColumn) {
            terjual += parseInt((r[matchedColumn] || '0').toString().replace(/[^0-9]/g, '')) || 0;
          }
        });
      } 
      // Fallback jika tidak ada di mapping (mencari nama kolom langsung)
      else {
        const matchedColumn = Object.keys(r).find(key => key.trim().toLowerCase() === tokoKey);
        if (matchedColumn) {
            terjual += parseInt((r[matchedColumn] || '0').toString().replace(/[^0-9]/g, '')) || 0;
        } else if ((r['Toko'] || '').trim().toLowerCase() === tokoKey) {
            terjual += parseInt((r['Terjual'] || '0').toString().replace(/[^0-9]/g, '')) || 0;
        }
