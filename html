window.resetPaLive = function() {
  if ($('pa-live-bulan')) $('pa-live-bulan').value = '';
  if ($('pa-live-tahun')) $('pa-live-tahun').value = '';
  S.pa.liveBulan = ''; S.pa.liveTahun = '';
  S.pa.livePage = 1;
  renderPaLive();
};

function renderPaLive() {
  S.pa.livePage = S.pa.livePage || 1;
  const rpp = 31;
  const data = S.pa.live || [];

  let validHeaders = S.pa.liveHeaders || (data.length > 0 ? Object.keys(data[0]) : []);
  let colTanggal = validHeaders.find(h => h.toLowerCase() === 'tanggal' || h.toLowerCase() === 'date') || 'Tanggal';

  // Ambil hanya kolom nama Admin (Host), pastikan BUKAN kolom tanggal, no, keterangan, dan JANGAN mengandung kata "status"
  let adminCols = validHeaders.filter(h => {
     let hl = h.toLowerCase().trim();
     return hl !== colTanggal.toLowerCase() && !hl.includes('status') && hl !== 'no' && hl !== 'keterangan';
  });

  const thead = document.querySelector('#page-pa-live table thead');
  if (thead) {
    let theadHTML = `<tr><th style="text-align:center;">No</th><th style="text-align:left;">${esc(colTanggal)}</th>`;
    adminCols.forEach(adm => { theadHTML += `<th style="text-align:center;">${esc(adm)}</th>`; });
    theadHTML += `</tr>`;
    thead.innerHTML = theadHTML;
  }

  const thnDropdown = $('pa-live-tahun');
  if (thnDropdown && thnDropdown.options.length <= 1) {
    const years = new Set();
    data.forEach(r => {
      let tglStr = r[colTanggal] || r['tanggal'];
      if(tglStr) {
         const dt = parseTgl(tglStr);
         if(dt && !isNaN(dt.getTime())) years.add(dt.getFullYear());
      }
    });
    const yearArr = Array.from(years).sort((a,b) => b - a);
    if(yearArr.length === 0) { for(let y = 2024; y <= new Date().getFullYear(); y++){ yearArr.push(y); } }
    yearArr.forEach(y => { thnDropdown.appendChild(new Option(y, y)); });
  }

  const bln = S.pa.liveBulan;
  const thn = S.pa.liveTahun;

  // Filter Mandiri
  let filtered = data.filter(r => paIsDateMatch(r, bln, thn));

  const totalData = filtered.length;
  const totalPg = Math.max(1, Math.ceil(totalData / rpp));
  if (S.pa.livePage > totalPg) S.pa.livePage = totalPg;

  const startIdx = (S.pa.livePage - 1) * rpp;
  const slice = filtered.slice(startIdx, startIdx + rpp);

  const tb = $('pa-live-tbody');
  if (!tb) return;

  if (!slice.length) {
    tb.innerHTML = `<tr><td colspan="${adminCols.length + 2}"><div class="empty"><div class="ei">📭</div><p>Tidak ada data performa live di periode ini</p></div></td></tr>`;
  } else {
    let htmlRows = slice.map((row, i) => {
      let realNo = startIdx + i + 1;
      let rawTgl = row[colTanggal] || row['tanggal'];
      let trHTML = `<tr>
        <td style="text-align:center;" class="num">${realNo}</td>
        <td style="font-weight:600; color:var(--t1)">${esc(formatTanggalTampilan(rawTgl))}</td>`;
      
      adminCols.forEach(adm => {
         let timeVal = row[adm];
         let isLibur = !timeVal || timeVal === '-' || timeVal.toString().toLowerCase() === 'libur';
         let displayVal = isLibur ? '—' : esc(timeVal);
         let colorStyle = isLibur ? 'color:var(--t3);' : 'font-weight:600; color:var(--t1);';
         
         trHTML += `<td class="num" style="text-align:center; ${colorStyle}">${displayVal}</td>`;
      });
      trHTML += `</tr>`;
      return trHTML;
    }).join('');

    // --- BAGIAN YANG DIPERBAIKI UNTUK MENCEGAH NaN ---
    let totals = {};
    adminCols.forEach(adm => totals[adm] = 0);
    slice.forEach(row => {
      adminCols.forEach(adm => { 
         let sec = timeToSeconds(row[adm]);
         totals[adm] += isNaN(sec) ? 0 : sec; // Jika ada typo seperti "3:00;00", maka dianggap 0 detik (tidak merusak total)
      });
    });
    // ------------------------------------------------

    let totalRowHTML = `<tr class="total-row"><td colspan="2" style="text-align:right; font-weight:800; color:var(--t1);">TOTAL HALAMAN INI:</td>`;
    adminCols.forEach(adm => { totalRowHTML += `<td class="num num-h" style="text-align:center;">${secondsToTime(totals[adm])}</td>`; });
    totalRowHTML += `</tr>`;
    
    tb.innerHTML = htmlRows + totalRowHTML;
  }

  const pinfo = $('pa-live-pinfo');
  const pbtns = $('pa-live-pbtns');
  if (pinfo) pinfo.textContent = `${totalData} data · Hal ${S.pa.livePage}/${totalPg}`;
  if (pbtns) renderPag('pa-live-pbtns', S.pa.livePage, totalPg, p => { S.pa.livePage = p; renderPaLive(); });
}

