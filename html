// FITUR BARU: Helper Hitung Total Dinamis Berdasarkan Sheet Setting
// =========================================================================
function getDinamisTotal(jenis, bulan, tahun) {
  const rawSettings = S.setting || S.pa.setting || [];
  let currentKategori = "";
  let total = 0;
  const targetToko = [];

  rawSettings.forEach(r => {
    let kat = (r['Kategori'] || '').toString().trim();
    if (kat) currentKategori = kat;
    let toko = (r['Toko'] || '').toString().trim();
    if (toko && currentKategori.toLowerCase().includes(jenis.toLowerCase())) {
      targetToko.push(toko);
    }
  });

  const sourceData = jenis === 'offline' 
    ? (S.pa.offline || S.pa.penjualan || []) 
    : (S.pa.online || S.pa.penjualan || []);
    
  const dataBulanIni = sourceData.filter(r => paIsDateMatch(r, bulan, tahun));

  // --- KAMUS MAPPING CHANNEL ONLINE ---
  const mapOnline = {
    'intan mutiara': ['shopee 1'],
    'mutiara flasher': [
      'shopee 4', 'shopee 6', 'shopee 9', 'shopee 12', 'shopee 13', 'shopee 14',
      'tokped 5', 'lazada 7', 'akulaku 1', 'akulaku 3'
    ],
    'tiga mutiara': []
  };

  dataBulanIni.forEach(r => {
    targetToko.forEach(toko => {
      const tokoKey = toko.trim().toLowerCase();

      // JIKA JENISNYA ONLINE DAN ADA DI KAMUS MAPPING
      if (jenis === 'online' && mapOnline[tokoKey]) {
        const channels = mapOnline[tokoKey];
        channels.forEach(ch => {
          const matchedColumn = Object.keys(r).find(key => key.trim().toLowerCase() === ch.toLowerCase());
          if (matchedColumn) {
            total += parseInt((r[matchedColumn] || '0').toString().replace(/[^0-9]/g, '')) || 0;
          }
        });
      } 
      // JIKA OFFLINE (TETAP PAKAI LOGIKA LAMA)
      else {
        const matchedColumn = Object.keys(r).find(key => key.trim().toLowerCase() === tokoKey);
        if (matchedColumn) {
          total += parseInt((r[matchedColumn] || '0').toString().replace(/[^0-9]/g, '')) || 0;
        } else if ((r['Toko'] || '').trim().toLowerCase() === tokoKey) {
          total += parseInt((r['Terjual'] || '0').toString().replace(/[^0-9]/g, '')) || 0;
        }
      }
    });
  });

  return total;
}

function renderPaDashboard() {
  const now = new Date();
  const targetBulan = S.pa.dashBulan || (now.getMonth() + 1).toString();
  const targetTahun = S.pa.dashTahun || now.getFullYear().toString();

  // 1. Total Penjualan (Dinamis)
  const totOff = getDinamisTotal('offline', targetBulan, targetTahun);
  const totOnl = getDinamisTotal('online', targetBulan, targetTahun);

  // 2. Hitung "Live Achieved" secara dinamis (Sinkron dengan Tabel)
  const rawSettings = S.setting || S.pa.setting || [];
  const liveMaster = [];
  let currentKategori = "";
  
  // Ambil target per host dari Setting
  rawSettings.forEach(r => {
    let kat = (r['Kategori'] || '').toString().trim();
    if (kat) currentKategori = kat;
    if (currentKategori.toLowerCase().includes('jam tayang live') || currentKategori.toLowerCase().includes('target jam')) {
      let host = (r['Host'] || '').toString().trim();
      let targetVal = (r['Jam'] || r['Target Live'] || '0').toString().trim();
      if (host) liveMaster.push({ host, target: timeToSeconds(targetVal) });
    }
  });

  // Hitung performa aktual dari data live
  const liveDataRaw = (S.pa.live || []).filter(r => paIsDateMatch(r, targetBulan, targetTahun));
  let liveAchCount = 0;

  liveMaster.forEach(m => {
    let terjualSecs = 0;
    const hostKey = m.host.toLowerCase().trim();
    
    liveDataRaw.forEach(r => {
      for (let key in r) {
        let header = key.toLowerCase().trim();
        // Skip kolom non-host
        if (header === 'tanggal' || header === 'no' || header === 'status') continue;
        
        // Cek kecocokan nama host
        if (header.includes(hostKey) || hostKey.includes(header)) {
          let durasi = r[key];
          if (durasi && durasi !== '-' && durasi.toLowerCase() !== 'libur') {
            terjualSecs += timeToSeconds(durasi);
          }
        }
      }
    });
    
    // Logika Achieved: Harus >= target dan target > 0
    if (terjualSecs >= m.target && m.target > 0) liveAchCount++;
  });


  // ====================================================================
  // 3. CHAT EXCELLENT (BAGIAN YANG DIGANTI - LOGIKA SINKRON DENGAN TABEL)
  // ====================================================================
  let chatExc = 0;
  const sourceChatData = S.pa.chat || S.pa.responChat || [];
  
  // a. Buang baris kosong
  const validChatData = sourceChatData.filter(row => {
    return Object.keys(row).some(key => {
      let k = key.toLowerCase();
      if (k.includes('tanggal') || k.includes('date') || k.includes('waktu')) return false;
      let val = row[key].toString().trim();
      return val !== '-' && val !== '' && /\d/.test(val); 
    });
  });

  // b. Urutkan berdasarkan tanggal terbaru
  const sortedChatData = validChatData.sort((a, b) => {
    const dA = parseSheetDateChat(a['Tanggal'] || a['TANGGAL'] || a['Date']);
    const dB = parseSheetDateChat(b['Tanggal'] || b['TANGGAL'] || b['Date']);
    return dB.getTime() - dA.getTime();
  });

  // c. Cari data bulan & tahun yang di-select (Minggu Ini)
  let rowDataTerpilih = null;
  for (let i = 0; i < sortedChatData.length; i++) {
    const d = parseSheetDateChat(sortedChatData[i]['Tanggal'] || sortedChatData[i]['TANGGAL'] || sortedChatData[i]['Date']);
    if (d.getMonth() + 1 === parseInt(targetBulan) && d.getFullYear() === parseInt(targetTahun)) {
        rowDataTerpilih = sortedChatData[i];
        break; 
    }
  }

  // d. Jika datanya ada, hitung berapa Admin yang Achieved / Tercapai
  if (rowDataTerpilih) {
    let tempKategoriChat = "";
    rawSettings.forEach(r => {
      let kat = (r['Kategori'] || '').toString().trim();
      if (kat) tempKategoriChat = kat;

      if (tempKategoriChat.toLowerCase().includes('chat')) {
        let online = (r['Online'] || r['Channel'] || '').toString().trim();
        let targetVal = parsePercentChat(r['Chat'] || r['Target'] || '0');
        
        if (online) {
          let channelKey = online.toLowerCase().trim();
          let matchedCol = Object.keys(rowDataTerpilih).find(k => k.toLowerCase().trim() === channelKey);
          
          if (matchedCol) {
            let valIni = parsePercentChat(rowDataTerpilih[matchedCol]);
            
            // LOGIKA TERCAPAI: Jika persentase minggu ini >= target setting
            if (valIni >= targetVal && targetVal > 0) {
               chatExc++;
            }
          }
        }
      }
    });
  }

  // 4. Render Grid
  $('pa-stats-grid').innerHTML = [
    {lbl:'Total Penjualan Offline', val:fmt(totOff), c:'c1',ic:'🏪', sub:`Bulan ${targetBulan}/${targetTahun}`},
    {lbl:'Total Penjualan Online',  val:fmt(totOnl), c:'c2',ic:'🛒', sub:`Bulan ${targetBulan}/${targetTahun}`},
    {lbl:'Live Achieved',           val:liveAchCount,c:'c5',ic:'🎥', sub:`Performa Live`},
    {lbl:'Chat Excellent',          val:chatExc,     c:'c4',ic:'💬', sub:'Performa terbaik'},
  ].map(s => `<div class="card stat-card"><div class="s-lbl">${s.lbl}</div><div class="s-val ${s.c}">${s.val}</div><div class="s-sub">${s.sub}</div><div class="s-ic">${s.ic}</div></div>`).join('');

  renderPaTables(targetBulan, targetTahun);
}

