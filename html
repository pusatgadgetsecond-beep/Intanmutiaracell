/* KC TABLE */
function kcFilter(){
  const q=($('kc-search')?.value||'').toLowerCase();
  const fm=$('kc-fm')?.value||'', fy=$('kc-fy')?.value||'', fp=$('kc-fp')?.value||'';
  S.kc.filtered=S.kc.data.filter(r=>{
    const matchQ=!q||r.judul.toLowerCase().includes(q)||r.link.toLowerCase().includes(q)||r.plat.toLowerCase().includes(q);
    const dt=parseTgl(r.tanggal);
    const matchM=!fm||(dt&&String(dt.getMonth()+1)===fm);
    const matchY=!fy||(dt&&String(dt.getFullYear())===fy);
    const matchP=!fp||r.plat===fp;
    return matchQ&&matchM&&matchY&&matchP;
  });
  S.kc.page=1; renderKcTableBody();
}
 
function renderKcTable(){
  S.kc.filtered=[...S.kc.data]; S.kc.page=1; renderKcTableBody();
}
 
function renderKcTableBody(){
  const arr=S.kc.filtered, rpp=S.kc.rpp, pg=S.kc.page;
  const total=arr.length, totalPg=Math.max(1,Math.ceil(total/rpp));
  if(pg>totalPg) S.kc.page=totalPg;
  const s=(S.kc.page-1)*rpp, slice=arr.slice(s,s+rpp);
  const tb=$('kc-tbody'); if(!tb) return;
 
  if(!slice.length){ tb.innerHTML=`<tr><td colspan="9"><div class="empty"><div class="ei">📭</div><p>Tidak ada data</p></div></td></tr>`; }
  else {
    tb.innerHTML=slice.map((r,i)=>{
      const pb=r.plat==='TikTok'?`<span class="badge b-tt">🎵 TikTok</span>`:`<span class="badge b-ig">📸 IG</span>`;
      const gi=S.kc.data.indexOf(r);
      return `<tr>
        <td class="num" style="color:var(--t3)">${s+i+1}</td>
        <td style="font-size:10.5px;font-family:var(--mono)">${esc(formatTanggalTampilan(r.tanggal))}</td>
        <td>${pb}</td>
        <td><a href="${esc(r.link)}" target="_blank" style="color:var(--c);font-size:10.5px" title="${esc(r.link)}">${esc(r.link.replace('https://','').substring(0,32))}…</a></td>
        <td style="max-width:180px;overflow:hidden;text-overflow:ellipsis" title="${esc(r.judul)}">${esc(r.judul)}</td>
        <td class="num num-h">${fmt(r.view)}</td>
        <td class="num">${r.storyIg||'—'}</td>
        <td class="num">${r.storyTk||'—'}</td>
        <td><div style="display:flex;gap:5px">
          <button class="btn btn-glass btn-sm" onclick="kcEdit(${gi})">✏️</button>
          <button class="btn btn-danger btn-sm" onclick="kcDelete(${gi})">🗑️</button>
        </div></td>
      </tr>`;
    }).join('');
  }
  $('kc-pinfo').textContent=`${total} data · Hal ${S.kc.page}/${totalPg}`;
  renderPag('kc-pbtns', S.kc.page, totalPg, p=>{ S.kc.page=p; renderKcTableBody(); });
}
 
