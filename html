window.renderStRiwayat = function() {
  S.st.riwayatPage = S.st.riwayatPage || 1;
  const rpp = 25; // Jumlah baris per halaman
  const data = S.st.riwayat || [];
  
  const q = ($('st-riwayat-search')?.value || '').toLowerCase();
  const bln = $('st-riwayat-bulan')?.value;
  
  // Auto populate tahun berdasarkan data sheet
  const thnDropdown = $('st-riwayat-tahun');
  if (thnDropdown && thnDropdown.options.length <= 1) {
    const years = new Set();
    data.forEach(r => {
      const tglStr = r['Tanggal'] || r['tanggal'];
      if (tglStr) {
        const dt = parseTgl(tglStr);
        if (dt && !isNaN(dt.getTime())) years.add(dt.getFullYear());
      }
    });
    const yearArr = Array.from(years).sort((a,b)=>b-a);
    if(yearArr.length === 0) yearArr.push(new Date().getFullYear());
    yearArr.forEach(y => {
      const opt = document.createElement('option');
      opt.value = y; opt.textContent = y;
      thnDropdown.appendChild(opt);
    });
  }
  const thn = thnDropdown?.value;

  // 1. Pemilahan Data (Filter)
  let filtered = data.filter(r => {
    // Live Search (Nama & ID)
    const nm = String(r['Nama Produk'] || r['nama produk'] || '').toLowerCase();
    const id = String(r['ID'] || r['id'] || '').toLowerCase();
    if (q && !nm.includes(q) && !id.includes(q)) return false;

    // Filter Bulan & Tahun
    const tglStr = r['Tanggal'] || r['tanggal'];
    if (!tglStr && (bln || thn)) return false;
    
    const dt = parseTgl(tglStr);
    if ((bln || thn) && (!dt || isNaN(dt.getTime()))) return false;
    
    if (bln && (dt.getMonth() + 1).toString() !== bln) return false;
    if (thn && dt.getFullYear().toString() !== thn) return false;

    return true;
  });

  // 2. Paginasi
  const totalData = filtered.length;
  const totalPg = Math.max(1, Math.ceil(totalData / rpp));
  if (S.st.riwayatPage > totalPg) S.st.riwayatPage = totalPg;

  const startIdx = (S.st.riwayatPage - 1) * rpp;
  const slice = filtered.slice(startIdx, startIdx + rpp);

  const tb = $('st-riwayat-tbody');
  if (!tb) return;

  // 3. Render Baris HTML
  if (!slice.length) {
    tb.innerHTML = `<tr><td colspan="7" class="empty-state-cell"><div style="display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; min-height: 250px; text-align: center;"><div style="font-size: 42px; margin-bottom: 12px; line-height: 1;">📭</div><p style="margin: 0; font-size: 15px; font-weight: 500; color: var(--t3);">Tidak ada riwayat revisi ditemukan</p></div></td></tr>`;
  } else {
    tb.innerHTML = slice.map(r => {
      const tglStr = formatTanggalTampilan(r['Tanggal'] || r['tanggal']);
      const action = r['Action'] || r['action'] || '-';
      
      let actClass = 'b-neu';
      let lowerAct = action.toLowerCase();
      if(lowerAct.includes('tambah') || lowerAct.includes('add')) actClass = 'b-ach'; 
      else if(lowerAct.includes('edit') || lowerAct.includes('update') || lowerAct.includes('revisi')) actClass = 'b-pro'; 
      else if(lowerAct.includes('hapus') || lowerAct.includes('delete')) actClass = 'b-mis'; 

      const cleanRow = {};
      Object.keys(r).forEach(key => {
        cleanRow[key.toString().toLowerCase().trim()] = r[key];
      });

      const nm = esc(cleanRow['nama produk'] || cleanRow['produk'] || cleanRow['nama barang'] || '-');
      const id = esc(cleanRow['id produk'] || cleanRow['id'] || '-'); 
      const sb = esc(cleanRow['stok baru'] || '-');
      const hg = fmtRp(cleanRow['harga terbaru'] || '0');
      const role = esc(cleanRow['role'] || '-');

      return `<tr>
        <td data-label="Tanggal" style="font-weight:600; color:var(--t1); font-size:11px;">${esc(tglStr)}</td>
        <td data-label="Role" style="color:var(--t2); font-size:11px;">${role}</td>
        <td data-label="Action"><span class="badge ${actClass}">${esc(action)}</span></td>
        <td data-label="ID" style="font-family:var(--mono);font-size:10.5px">${id}</td>
        <td data-label="Nama Produk"><div style="font-weight:700;font-size:12.5px; white-space: normal;">${nm}</div></td>
        <td data-label="Stok Baru" class="num">${sb}</td>
        <td data-label="Harga Terbaru" class="num" style="font-size:11.5px">${hg}</td>
      </tr>`;
    }).join('');
  }

  // 4. Render Tombol Navigasi Halaman
  const pinfo = $('st-riwayat-pinfo');
  const pbtns = $('st-riwayat-pbtns');
  if (pinfo) pinfo.textContent = `${totalData} riwayat · Hal ${S.st.riwayatPage}/${totalPg}`;
  if (pbtns) renderPag('st-riwayat-pbtns', S.st.riwayatPage, totalPg, p => { 
