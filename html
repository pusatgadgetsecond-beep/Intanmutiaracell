document.addEventListener('DOMContentLoaded', () => {
  
  // 1. Fungsi Global Format Rupiah Real-time
  function formatInputRupiah(e) {
    let input = e.target;
    // Simpan posisi kursor saat ini
    let originalCursorPos = input.selectionStart;
    let originalLength = input.value.length;

    // Hilangkan semua karakter selain angka (huruf, titik, koma otomatis hilang)
    let rawValue = input.value.replace(/[^\d]/g, '');

    // Jika kosong, biarkan kosong
    if (rawValue === '') {
      input.value = '';
      return;
    }

    // Format dengan titik pemisah ribuan dan beri prefix 'Rp'
    let formattedValue = 'Rp' + rawValue.replace(/\B(?=(\d{3})+(?!\d))/g, ".");
    input.value = formattedValue;

    // Kalkulasi pergeseran posisi kursor agar tidak melompat ke belakang
    let MathDiff = input.value.length - originalLength;
    let newCursorPos = originalCursorPos + MathDiff;
    
    // Cegah kursor terjebak di dalam tulisan "Rp"
    if (newCursorPos < 2) newCursorPos = 2;
    
    // Kembalikan kursor ke posisi yang presisi
    input.setSelectionRange(newCursorPos, newCursorPos);
  }

  // 2. Terapkan event listener ke input Harga Jual dan Harga Terbaru
  const inputHarga1 = document.getElementById('st-harga');
  const inputHarga2 = document.getElementById('st-harga2');

  if (inputHarga1) inputHarga1.addEventListener('input', formatInputRupiah);
  if (inputHarga2) inputHarga2.addEventListener('input', formatInputRupiah);

  // 3. Modifikasi fungsi stEdit yang sudah ada TANPA mengubah kode aslinya
  if (typeof window.stEdit === 'function') {
    const originalStEdit = window.stEdit; // Simpan fungsi asli
    window.stEdit = function(id, nm, vr, sl, sb, hp, hb) {
      // Jalankan fungsi aslinya terlebih dahulu
      originalStEdit(id, nm, vr, sl, sb, hp, hb);
      
      // Pancing event 'input' agar nilai yang baru dimasukkan otomatis terformat
      if (inputHarga1 && inputHarga1.value !== '') {
        inputHarga1.dispatchEvent(new Event('input'));
      }
      if (inputHarga2 && inputHarga2.value !== '') {
         inputHarga2.dispatchEvent(new Event('input'));
      }
    };
  }
});

