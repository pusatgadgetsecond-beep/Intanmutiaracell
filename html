            value="${savedDiscount > 0 ? toRupiah(savedDiscount) : ''}" placeholder="Rp 0" />
        </td>
        <td data-label="Harga Diskon" class="txt-diskon">${finalPriceHTML}</td>
        <td data-label="Aksi" style="text-align: right;">
          <button class="btn btn-danger btn-sm btn-fs-remove" data-id="${id}" title="Hapus Produk" 
            style="padding: 0; width: 30px; height: 30px; display: inline-flex; align-items: center; justify-content: center;">✕</button>
        </td>
      </tr>`;
  });

  tableHTML += `</tbody></table></div>`;

  // 🟢 PERUBAHAN: Pagination UI sesuai gaya Dashboard Utama (SaaS Theme)
  if (totalItems > 0) {
    let pagHTML = `
      <div class="pag" style="padding: 12px 24px; border-top: 1px solid var(--border); background: var(--bg2); border-radius: 0 0 var(--r-lg) var(--r-lg);">
        <span class="pag-info">Menampilkan ${totalItems === 0 ? 0 : startIndex + 1}-${endIndex} dari ${totalItems} produk</span>
        <div class="pag-btns">
          <button class="pag-btn sp-prev" ${window.currentSelectedPage === 1 ? 'disabled' : ''} style="width: auto; padding: 0 12px;">&lsaquo; Sebelumnya</button>
    `;

    // Logika Ellipsis (Menampilkan maksimal 3 angka berdekatan, sisanya ...)
    let startP = Math.max(1, window.currentSelectedPage - 1);
    let endP = Math.min(totalPages, window.currentSelectedPage + 1);

    if (window.currentSelectedPage === 1 && totalPages >= 3) endP = 3;
    if (window.currentSelectedPage === totalPages && totalPages >= 3) startP = totalPages - 2;

    if (startP > 1) {
      pagHTML += `<button class="pag-btn sp-num" data-page="1">1</button>`;
      if (startP > 2) pagHTML += `<span style="color:var(--t3); padding:0 4px; font-size:12px; display:flex; align-items:center;">…</span>`;
    }

    for (let i = startP; i <= endP; i++) {
      pagHTML += `<button class="pag-btn sp-num ${i === window.currentSelectedPage ? 'on' : ''}" data-page="${i}">${i}</button>`;
    }

    if (endP < totalPages) {
      if (endP < totalPages - 1) pagHTML += `<span style="color:var(--t3); padding:0 4px; font-size:12px; display:flex; align-items:center;">…</span>`;
      pagHTML += `<button class="pag-btn sp-num" data-page="${totalPages}">${totalPages}</button>`;
    }

    pagHTML += `
          <button class="pag-btn sp-next" ${window.currentSelectedPage === totalPages ? 'disabled' : ''} style="width: auto; padding: 0 12px;">Berikutnya &rsaquo;</button>
        </div>
      </div>
    `;
    tableHTML += pagHTML;
  }

  selectedContainer.innerHTML = tableHTML;

  // Event Listener: Menyimpan diskon saat nilai diubah (State Terjaga)
  selectedContainer.querySelectorAll('.fs-discount-input').forEach(inp => {
    inp.addEventListener('input', function() {
      const id = this.getAttribute('data-id');
      let val = cleanRupiah(this.value);
      const tr = this.closest('tr');
      const basePrice = parseInt(tr.querySelector('[data-base]').getAttribute('data-base')) || 0;
      const diskonEl = tr.querySelector('.txt-diskon');

      if (this.value.trim() === '' || val === 0) {
          window.flashSaleDiscounts[id] = 0;
          this.value = '';
          diskonEl.innerHTML = `<span class="badge b-neu">Belum Diatur</span>`;
          return;
      }

      if (val > basePrice) {
        window.flashSaleDiscounts[id] = val; 
        this.value = toRupiah(val);
        diskonEl.innerHTML = `<span class="num num-n" style="font-size: 13px; transition: var(--tx);">Rp 0</span>`;
        toast('Potongan tidak boleh melebihi harga asli', 'warn'); 
        return;
      }

      window.flashSaleDiscounts[id] = val;
      this.value = toRupiah(val);
      diskonEl.innerHTML = `<span class="num num-h" style="font-size: 13px; transition: var(--tx);">${toRupiah(basePrice - val)}</span>`;
    });
  });

  // Event Listener: Hapus Produk
  selectedContainer.querySelectorAll('.btn-fs-remove').forEach(btn => {
    btn.addEventListener('click', function() {
      const id = String(this.getAttribute('data-id'));
      
      confirmedProductIds.delete(id);      // Hapus dari state Flash Sale
      tempSelectedProductIds.delete(id);   // Hapus dari state Modal (Sinkron)
      delete window.flashSaleDiscounts[id];
      
      // Amankan halaman jika halaman terakhir kosong karena dihapus
      const remainingPages = Math.ceil(confirmedProductIds.size / rpp) || 1;
      if (window.currentSelectedPage > remainingPages) window.currentSelectedPage = remainingPages;

      window.renderSelectedProducts();
      updateFooterCount();
    });
  });

  // Event Listener: Tombol Navigasi Pagination
  const prevBtn = selectedContainer.querySelector('.sp-prev');
  const nextBtn = selectedContainer.querySelector('.sp-next');
  const numBtns = selectedContainer.querySelectorAll('.sp-num');

  if (prevBtn) prevBtn.addEventListener('click', () => { 
    if (window.currentSelectedPage > 1) { 
      window.currentSelectedPage--; window.renderSelectedProducts(); 
    }
  });
  
  if (nextBtn) nextBtn.addEventListener('click', () => { 
    if (window.currentSelectedPage < totalPages) { 
      window.currentSelectedPage++; window.renderSelectedProducts(); 
    }
  });
  
  numBtns.forEach(btn => btn.addEventListener('click', function() {
    window.currentSelectedPage = parseInt(this.getAttribute('data-page'));
    window.renderSelectedProducts();
  }));
};

